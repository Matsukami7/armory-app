---
import '../styles/global.css';
import { isUsingDefaultPassword } from '../lib/auth';
import { getTheme, THEMES } from '../lib/theme';

interface Props {
  title?: string;
  sub?: string;
  backHref?: string;
  backLabel?: string;
  actions?: any;
}

const { title = 'Dashboard', sub, backHref } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const theme = getTheme(Astro.request);
const defaultPw = isUsingDefaultPassword();

const sidebarExtra = [
  {
    href: '/maintenance',
    label: 'Maintenance',
    sub: 'Cleaning schedule',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l5.653-4.655m5.17-2.496l3.03-2.496a1.5 1.5 0 00-1.768-2.432L11.42 15.17" />`,
  },
  {
    href: '/training',
    label: 'Training',
    sub: 'Structured plans',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />`,
  },
  {
    href: '/groups',
    label: 'Shot Groups',
    sub: 'Precision tracking',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m0-10.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /><circle cx="12" cy="16" r="1.5" fill="currentColor" />`,
  },
  {
    href: '/wishlist',
    label: 'Wish List',
    sub: 'Want to acquire',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />`,
  },
  {
    href: '/builds',
    label: 'AR Builds',
    sub: 'Build planner',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l5.653-4.655m5.17-2.496l3.03-2.496a1.5 1.5 0 00-1.768-2.432L11.42 15.17" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />`,
  },
  {
    href: '/reports',
    label: 'Reports',
    sub: 'Spend & analytics',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />`,
  },
  {
    href: '/footage',
    label: 'Footage',
    sub: 'Videos & recordings',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />`,
  },
];

const nav = [
  {
    href: '/',
    label: 'Command',
    sub: 'Overview & stats',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
  },
  {
    href: '/firearms',
    label: 'Vault',
    sub: 'Firearms inventory',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
  },
  {
    href: '/sessions',
    label: 'Range',
    sub: 'Sessions & drills',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />`,
  },
  {
    href: '/ammo',
    label: 'Ammo',
    sub: 'Ammunition storage',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    href: '/drills',
    label: 'Drills',
    sub: 'Progress & history',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />`,
  },
  {
    href: '/gear',
    label: 'Gear',
    sub: 'Supplies & consumables',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />`,
  },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!DOCTYPE html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="var(--bg-base)" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title} — Armory</title>
</head>
<body>

<div class="app-shell">

  <!-- ── Sidebar ───────────────────────────────────────── -->
  <aside class="sidebar">

    <!-- Brand -->
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <div class="sidebar-brand-name">Armory</div>
        <div class="sidebar-brand-sub">Armory Platform</div>
      </div>
    </div>

    {defaultPw && (
      <div class="pw-warning" style="font-size:0.6rem;padding:0.375rem 1rem;">
        Default password active — set <code>ARMORY_PASSWORD</code>
      </div>
    )}

    <!-- Search -->
    <div style="padding:0 0.75rem 0.25rem">
      <form method="GET" action="/search">
        <div style="position:relative">
          <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"
               style="position:absolute;left:0.625rem;top:50%;transform:translateY(-50%);color:var(--text-dim);pointer-events:none">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input name="q" type="search" placeholder="Search…"
                 style="width:100%;padding:0.375rem 0.625rem 0.375rem 2rem;font-size:0.75rem;background:var(--bg-hover);border:1px solid var(--border);border-radius:0.375rem;color:var(--text);box-sizing:border-box" />
        </div>
      </form>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav">
      <div class="sidebar-nav-label">Navigation</div>
      {[...nav, ...sidebarExtra].map(item => (
        <a href={item.href} class={`nav-item ${isActive(item.href) ? 'active' : ''}`}>
          <svg class="nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
          <div class="nav-item-text">
            <div class="nav-item-label">{item.label}</div>
            <div class="nav-item-sub">{item.sub}</div>
          </div>
        </a>
      ))}
    </nav>

    <!-- Footer: themes + logout -->
    <div class="sidebar-footer">
      <div>
        <div class="theme-label">Color Theme</div>
        <div class="theme-swatches">
          {Object.entries(THEMES).map(([key, t]) => (
            <form method="POST" action="/api/theme" style="display:contents">
              <input type="hidden" name="theme" value={key} />
              <input type="hidden" name="back" value={pathname} />
              <button
                type="submit"
                class={`theme-swatch ${theme === key ? 'active' : ''}`}
                style={`background:${t.color}`}
                title={t.label}
              />
            </form>
          ))}
        </div>
      </div>
      <div style="display:flex;gap:0.5rem">
        <a href="/settings" class="sidebar-logout" style={pathname.startsWith('/settings') ? 'color:var(--accent)' : ''}>
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Settings
        </a>
        <a href="/api/auth/logout" class="sidebar-logout">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
          </svg>
          Logout
        </a>
      </div>
    </div>
  </aside>

  <!-- ── Main area ─────────────────────────────────────── -->
  <div class="main-area">

    <!-- Page header -->
    <div class="page-header">
      <div class="page-header-left">
        {backHref && (
          <a href={backHref} class="page-back">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
        )}
        <div>
          <div class="page-title">{title}</div>
          {sub && <div class="page-sub">{sub}</div>}
        </div>
      </div>
      <slot name="actions" />
    </div>

    <!-- Scrollable content -->
    <div class="page-content">
      <slot />
    </div>

  </div>

  <!-- ── Mobile bottom nav ──────────────────────────────── -->
  <nav class="bottom-nav">
    <div class="bottom-nav-inner">
      {nav.map(item => (
        <a href={item.href} class={`bottom-nav-item ${isActive(item.href) ? 'active' : ''}`}>
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
          {item.label}
        </a>
      ))}
    </div>
  </nav>

</div>
</body>
</html>
