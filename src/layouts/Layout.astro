---
import '../styles/global.css';
import { isUsingDefaultPassword } from '../lib/auth';
import { getTheme, THEMES } from '../lib/theme';

interface Props {
  title?: string;
  sub?: string;
  backHref?: string;
  backLabel?: string;
  actions?: any;
}

const { title = 'Dashboard', sub, backHref } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
const theme = getTheme(Astro.request);
const defaultPw = isUsingDefaultPassword();

const nav = [
  {
    href: '/',
    label: 'Command',
    sub: 'Overview & stats',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
  },
  {
    href: '/firearms',
    label: 'Vault',
    sub: 'Firearms inventory',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
  },
  {
    href: '/sessions',
    label: 'Range',
    sub: 'Sessions & drills',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />`,
  },
  {
    href: '/ammo',
    label: 'Ammo',
    sub: 'Ammunition storage',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!DOCTYPE html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="var(--bg-base)" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title} — Armory</title>
</head>
<body>

<div class="app-shell">

  <!-- ── Sidebar ───────────────────────────────────────── -->
  <aside class="sidebar">

    <!-- Brand -->
    <div class="sidebar-brand">
      <div class="sidebar-brand-icon">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <div class="sidebar-brand-name">Armory</div>
        <div class="sidebar-brand-sub">Armory Platform</div>
      </div>
    </div>

    {defaultPw && (
      <div class="pw-warning" style="font-size:0.6rem;padding:0.375rem 1rem;">
        Default password active — set <code>ARMORY_PASSWORD</code>
      </div>
    )}

    <!-- Nav -->
    <nav class="sidebar-nav">
      <div class="sidebar-nav-label">Navigation</div>
      {nav.map(item => (
        <a href={item.href} class={`nav-item ${isActive(item.href) ? 'active' : ''}`}>
          <svg class="nav-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
          <div class="nav-item-text">
            <div class="nav-item-label">{item.label}</div>
            <div class="nav-item-sub">{item.sub}</div>
          </div>
        </a>
      ))}
    </nav>

    <!-- Footer: themes + logout -->
    <div class="sidebar-footer">
      <div>
        <div class="theme-label">Color Theme</div>
        <div class="theme-swatches">
          {Object.entries(THEMES).map(([key, t]) => (
            <form method="POST" action="/api/theme" style="display:contents">
              <input type="hidden" name="theme" value={key} />
              <input type="hidden" name="back" value={pathname} />
              <button
                type="submit"
                class={`theme-swatch ${theme === key ? 'active' : ''}`}
                style={`background:${t.color}`}
                title={t.label}
              />
            </form>
          ))}
        </div>
      </div>
      <a href="/api/auth/logout" class="sidebar-logout">
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
        </svg>
        Logout
      </a>
    </div>
  </aside>

  <!-- ── Main area ─────────────────────────────────────── -->
  <div class="main-area">

    <!-- Page header -->
    <div class="page-header">
      <div class="page-header-left">
        {backHref && (
          <a href={backHref} class="page-back">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </a>
        )}
        <div>
          <div class="page-title">{title}</div>
          {sub && <div class="page-sub">{sub}</div>}
        </div>
      </div>
      <slot name="actions" />
    </div>

    <!-- Scrollable content -->
    <div class="page-content">
      <slot />
    </div>

  </div>

  <!-- ── Mobile bottom nav ──────────────────────────────── -->
  <nav class="bottom-nav">
    <div class="bottom-nav-inner">
      {nav.map(item => (
        <a href={item.href} class={`bottom-nav-item ${isActive(item.href) ? 'active' : ''}`}>
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
          {item.label}
        </a>
      ))}
    </div>
  </nav>

</div>
</body>
</html>
