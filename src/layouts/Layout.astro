---
import '../styles/global.css';

interface Props {
  title?: string;
  backHref?: string;
  backLabel?: string;
}

const { title = 'Armory', backHref, backLabel } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;

const nav = [
  { href: '/', label: 'Dashboard', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { href: '/firearms', label: 'Firearms', icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4' },
  { href: '/sessions', label: 'Range', icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z' },
  { href: '/ammo', label: 'Ammo', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
];
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} — Armory</title>
  </head>
  <body class="h-full flex flex-col text-zinc-100">

    <!-- Top header -->
    <header class="bg-zinc-900 border-b border-zinc-800 px-4 py-3 flex items-center gap-3 sticky top-0 z-10">
      {backHref ? (
        <a href={backHref} class="text-zinc-400 hover:text-zinc-100 transition-colors mr-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
      ) : null}
      <h1 class="text-base font-semibold text-zinc-100 flex-1 truncate">{title}</h1>
      <a href="/api/auth/logout" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">Logout</a>
    </header>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto pb-20">
      <slot />
    </main>

    <!-- Bottom nav -->
    <nav class="fixed bottom-0 inset-x-0 bg-zinc-900 border-t border-zinc-800 flex safe-bottom z-10">
      {nav.map(item => {
        const active = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`flex-1 flex flex-col items-center gap-1 py-3 text-xs transition-colors ${active ? 'text-amber-400' : 'text-zinc-500 hover:text-zinc-300'}`}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={item.icon} />
            </svg>
            {item.label}
          </a>
        );
      })}
    </nav>

  </body>
</html>
