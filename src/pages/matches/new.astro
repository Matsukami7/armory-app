---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { uspsaMatches, firearms, ammoInventory, rangeSessions, sessionFirearms } from '../../db/schema';
import { isNotNull, eq, sql } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const num = (key: string) => form.get(key) ? parseFloat(form.get(key) as string) : null;
  const int = (key: string) => form.get(key) ? parseInt(form.get(key) as string) : null;

  const matchDate = form.get('date') as string;
  const matchLocation = form.get('location') as string || null;
  const firearmId = int('firearmId');
  const roundsFired = int('roundsFired');
  const ammoId = int('ammoId');

  let linkedSessionId: number | null = null;
  if (firearmId && roundsFired && roundsFired > 0) {
    // Find or create a session for the match date, same convention as Quick Log —
    // this is what makes match rounds count toward lifetime rounds, barrel wear, and ammo spend.
    const [existing] = await db.select().from(rangeSessions).where(eq(rangeSessions.date, matchDate)).limit(1);
    if (existing) {
      linkedSessionId = existing.id;
      if (matchLocation && !existing.location) {
        await db.update(rangeSessions).set({ location: matchLocation }).where(eq(rangeSessions.id, linkedSessionId));
      }
    } else {
      const [session] = await db.insert(rangeSessions).values({ date: matchDate, location: matchLocation }).returning({ id: rangeSessions.id });
      linkedSessionId = session.id;
    }
    await db.insert(sessionFirearms).values({ sessionId: linkedSessionId, firearmId, roundsFired, ammoId });
    if (ammoId) {
      await db.run(sql`UPDATE ammo_inventory SET quantity = MAX(0, quantity - ${roundsFired}) WHERE id = ${ammoId}`);
    }
  }

  const [inserted] = await db.insert(uspsaMatches).values({
    name:           form.get('name') as string,
    date:           matchDate,
    location:       matchLocation,
    division:       form.get('division') as string || null,
    matchLevel:     form.get('matchLevel') as string || null,
    overallPlace:   int('overallPlace'),
    overallPercent: num('overallPercent'),
    pointsLost:     num('pointsLost'),
    avgPointsLost:  num('avgPointsLost'),
    pointsPercent:  num('pointsPercent'),
    totalTime:      num('totalTime'),
    countA:         int('countA'),
    countC:         int('countC'),
    countD:         int('countD'),
    countM:         int('countM'),
    countNs:        int('countNs'),
    firearmId,
    ammoId,
    roundsFired,
    sessionId:      linkedSessionId,
    notes:          form.get('notes') as string || null,
  }).returning({ id: uspsaMatches.id });
  return Astro.redirect(`/matches/${inserted.id}`);
}

const today = new Date().toISOString().split('T')[0];
const divisionRows = await db.selectDistinct({ division: uspsaMatches.division }).from(uspsaMatches).where(isNotNull(uspsaMatches.division));
const pastDivisions = [...new Set([
  ...divisionRows.map(r => r.division as string),
  'Open', 'Limited', 'Limited 10', 'PCC', 'Carry Optics', 'Production', 'Single Stack', 'Revolver', 'Limited Optics',
])].sort();

const allFirearms = await db.select().from(firearms).orderBy(firearms.name);
const allAmmo = await db.select().from(ammoInventory).where(sql`quantity > 0`).orderBy(ammoInventory.caliber);
---

<Layout title="Log Match" backHref="/matches">
  <form method="POST" class="form-section" style="max-width:36rem">

    <div><label>Match Name *</label><input name="name" type="text" required placeholder="e.g. July Blackstone Shooting USPSA Third Monday Match" /></div>

    <div class="form-row form-row-2">
      <div><label>Date *</label><input name="date" type="date" required value={today} /></div>
      <div><label>Location</label><input name="location" type="text" placeholder="e.g. Blackstone Shooting Sports" /></div>
    </div>

    <datalist id="divisions">
      {pastDivisions.map(d => <option value={d} />)}
    </datalist>
    <div class="form-row form-row-2">
      <div><label>Division</label><input name="division" type="text" list="divisions" placeholder="e.g. Open" /></div>
      <div>
        <label>Match Level</label>
        <select name="matchLevel">
          <option value="">— None —</option>
          <option value="club">Club</option>
          <option value="area">Area</option>
          <option value="state">State</option>
          <option value="national">National</option>
        </select>
      </div>
    </div>

    <div style="border:1px solid var(--border);border-radius:0.5rem;padding:1rem;display:flex;flex-direction:column;gap:0.75rem">
      <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted)">Overall Match Results (optional — from PractiScore)</div>
      <div class="form-row form-row-2">
        <div><label>Overall Place</label><input name="overallPlace" type="number" min="1" placeholder="4" /></div>
        <div><label>Overall %</label><input name="overallPercent" type="number" step="0.01" min="0" max="100" placeholder="54.74" /></div>
      </div>
      <div class="form-row form-row-2">
        <div><label>Points Lost (PL)</label><input name="pointsLost" type="number" step="0.01" placeholder="175.62" /></div>
        <div><label>Avg Points Lost (APL)</label><input name="avgPointsLost" type="number" step="0.01" placeholder="43.91" /></div>
      </div>
      <div class="form-row form-row-2">
        <div><label>Points %</label><input name="pointsPercent" type="number" step="0.01" min="0" max="100" placeholder="81" /></div>
        <div><label>Total Time (s)</label><input name="totalTime" type="number" step="0.01" placeholder="229.90" /></div>
      </div>
      <div>
        <label>Hit Counts — A / C / D / M / NS</label>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem">
          <input name="countA" type="number" min="0" placeholder="A" />
          <input name="countC" type="number" min="0" placeholder="C" />
          <input name="countD" type="number" min="0" placeholder="D" />
          <input name="countM" type="number" min="0" placeholder="M" />
          <input name="countNs" type="number" min="0" placeholder="NS" />
        </div>
      </div>
    </div>

    <div style="border:1px solid var(--border);border-radius:0.5rem;padding:1rem;display:flex;flex-direction:column;gap:0.75rem">
      <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted)">
        Log Rounds Fired <span style="text-transform:none;font-weight:400">(optional — single firearm; counts toward lifetime rounds, barrel wear, and ammo spend like a range session)</span>
      </div>
      <div>
        <label>Firearm</label>
        <select name="firearmId" id="m-firearm" onchange="mFilterAmmo()">
          <option value="">— None —</option>
          {allFirearms.map(f => <option value={f.id} data-caliber={f.caliber}>{f.name} ({f.caliber})</option>)}
        </select>
      </div>
      <div class="form-row form-row-2">
        <div><label>Rounds Fired</label><input name="roundsFired" type="number" min="1" placeholder="150" /></div>
        <div>
          <label>Ammo Used</label>
          <select name="ammoId" id="m-ammo">
            <option value="">None</option>
            {allAmmo.map(a => <option value={a.id} data-caliber={a.caliber}>{a.brand} {a.grain ? `${a.grain}gr ` : ''}{a.caliber} — {a.quantity.toLocaleString()} in stock</option>)}
          </select>
        </div>
      </div>
    </div>

    <div><label>Notes</label><textarea name="notes" rows="3" placeholder="Squad, conditions, gear used..."></textarea></div>

    <p style="font-size:0.75rem;color:var(--text-muted)">Stages and video can be added after saving.</p>

    <button type="submit" class="btn btn-primary btn-full">Create Match</button>
  </form>
</Layout>

<script>
  function mFilterAmmo() {
    const firearmSel = document.getElementById('m-firearm') as HTMLSelectElement | null;
    const ammoSel = document.getElementById('m-ammo') as HTMLSelectElement | null;
    if (!firearmSel || !ammoSel) return;
    const caliber = firearmSel.options[firearmSel.selectedIndex]?.dataset?.caliber ?? '';
    Array.from(ammoSel.options).forEach(opt => {
      if (!opt.value) return;
      opt.hidden = caliber ? opt.dataset.caliber !== caliber : false;
    });
    if (ammoSel.options[ammoSel.selectedIndex]?.hidden) ammoSel.value = '';
  }
</script>
