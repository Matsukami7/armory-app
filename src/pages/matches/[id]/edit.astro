---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../db';
import { uspsaMatches } from '../../../db/schema';
import { eq, isNotNull } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/matches');

const [match] = await db.select().from(uspsaMatches).where(eq(uspsaMatches.id, id));
if (!match) return Astro.redirect('/matches');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const num = (key: string) => form.get(key) ? parseFloat(form.get(key) as string) : null;
  const int = (key: string) => form.get(key) ? parseInt(form.get(key) as string) : null;

  await db.update(uspsaMatches).set({
    name:           form.get('name') as string,
    date:           form.get('date') as string,
    location:       form.get('location') as string || null,
    division:       form.get('division') as string || null,
    matchLevel:     form.get('matchLevel') as string || null,
    overallPlace:   int('overallPlace'),
    overallPercent: num('overallPercent'),
    pointsLost:     num('pointsLost'),
    avgPointsLost:  num('avgPointsLost'),
    pointsPercent:  num('pointsPercent'),
    totalTime:      num('totalTime'),
    countA:         int('countA'),
    countC:         int('countC'),
    countD:         int('countD'),
    countM:         int('countM'),
    countNs:        int('countNs'),
    notes:          form.get('notes') as string || null,
  }).where(eq(uspsaMatches.id, id));
  return Astro.redirect(`/matches/${id}`);
}

const divisionRows = await db.selectDistinct({ division: uspsaMatches.division }).from(uspsaMatches).where(isNotNull(uspsaMatches.division));
const pastDivisions = [...new Set([
  ...divisionRows.map(r => r.division as string),
  'Open', 'Limited', 'Limited 10', 'PCC', 'Carry Optics', 'Production', 'Single Stack', 'Revolver', 'Limited Optics',
])].sort();
---

<Layout title={`Edit — ${match.name}`} backHref={`/matches/${id}`}>
  <form method="POST" class="form-section" style="max-width:36rem">

    <div><label>Match Name *</label><input name="name" type="text" required value={match.name} /></div>

    <div class="form-row form-row-2">
      <div><label>Date *</label><input name="date" type="date" required value={match.date} /></div>
      <div><label>Location</label><input name="location" type="text" value={match.location ?? ''} /></div>
    </div>

    <datalist id="divisions">
      {pastDivisions.map(d => <option value={d} />)}
    </datalist>
    <div class="form-row form-row-2">
      <div><label>Division</label><input name="division" type="text" list="divisions" value={match.division ?? ''} /></div>
      <div>
        <label>Match Level</label>
        <select name="matchLevel">
          <option value="" selected={!match.matchLevel}>— None —</option>
          {[['club', 'Club'], ['area', 'Area'], ['state', 'State'], ['national', 'National']].map(([v, label]) => (
            <option value={v} selected={match.matchLevel === v}>{label}</option>
          ))}
        </select>
      </div>
    </div>

    <div style="border:1px solid var(--border);border-radius:0.5rem;padding:1rem;display:flex;flex-direction:column;gap:0.75rem">
      <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted)">Overall Match Results</div>
      <div class="form-row form-row-2">
        <div><label>Overall Place</label><input name="overallPlace" type="number" min="1" value={match.overallPlace ?? ''} /></div>
        <div><label>Overall %</label><input name="overallPercent" type="number" step="0.01" min="0" max="100" value={match.overallPercent ?? ''} /></div>
      </div>
      <div class="form-row form-row-2">
        <div><label>Points Lost (PL)</label><input name="pointsLost" type="number" step="0.01" value={match.pointsLost ?? ''} /></div>
        <div><label>Avg Points Lost (APL)</label><input name="avgPointsLost" type="number" step="0.01" value={match.avgPointsLost ?? ''} /></div>
      </div>
      <div class="form-row form-row-2">
        <div><label>Points %</label><input name="pointsPercent" type="number" step="0.01" min="0" max="100" value={match.pointsPercent ?? ''} /></div>
        <div><label>Total Time (s)</label><input name="totalTime" type="number" step="0.01" value={match.totalTime ?? ''} /></div>
      </div>
      <div>
        <label>Hit Counts — A / C / D / M / NS</label>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem">
          <input name="countA" type="number" min="0" value={match.countA ?? ''} placeholder="A" />
          <input name="countC" type="number" min="0" value={match.countC ?? ''} placeholder="C" />
          <input name="countD" type="number" min="0" value={match.countD ?? ''} placeholder="D" />
          <input name="countM" type="number" min="0" value={match.countM ?? ''} placeholder="M" />
          <input name="countNs" type="number" min="0" value={match.countNs ?? ''} placeholder="NS" />
        </div>
      </div>
    </div>

    <div><label>Notes</label><textarea name="notes" rows="3">{match.notes ?? ''}</textarea></div>

    <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
  </form>
</Layout>
