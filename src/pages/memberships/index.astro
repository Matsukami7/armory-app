---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { rangeMemberships, rangeSessions } from '../../db/schema';
import { eq, sql } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'add') {
    await db.insert(rangeMemberships).values({
      name:          form.get('name') as string,
      locationMatch: form.get('locationMatch') as string || null,
      monthlyFee:    form.get('monthlyFee')  ? parseFloat(form.get('monthlyFee')  as string) : null,
      hourlyRate:    form.get('hourlyRate')  ? parseFloat(form.get('hourlyRate')  as string) : null,
      dayRate:       form.get('dayRate')     ? parseFloat(form.get('dayRate')     as string) : null,
      startDate:     form.get('startDate')   as string,
      endDate:       form.get('endDate')     as string || null,
      status:        form.get('status')      as string || 'active',
      notes:         form.get('notes')       as string || null,
    });
  }

  if (action === 'delete') {
    await db.delete(rangeMemberships).where(eq(rangeMemberships.id, parseInt(form.get('id') as string)));
  }

  return Astro.redirect('/memberships');
}

const memberships = await db.select().from(rangeMemberships).orderBy(rangeMemberships.status, rangeMemberships.name);

// Current month string e.g. "2026-06"
const currentMonth = new Date().toISOString().slice(0, 7);

// For each membership, compute current-month session stats
const membershipStats = await Promise.all(memberships.map(async (m) => {
  if (!m.locationMatch) return { sessions: 0, totalMinutes: 0 };
  const [row] = await db
    .select({
      sessions:     sql<number>`COUNT(*)`,
      totalMinutes: sql<number>`SUM(COALESCE(${rangeSessions.durationMinutes}, 0))`,
    })
    .from(rangeSessions)
    .where(sql`strftime('%Y-%m', ${rangeSessions.date}) = ${currentMonth}
           AND LOWER(${rangeSessions.location}) LIKE LOWER('%' || ${m.locationMatch} || '%')`);
  return { sessions: row?.sessions ?? 0, totalMinutes: row?.totalMinutes ?? 0 };
}));

// All-time session counts per membership
const allTimeCounts = await Promise.all(memberships.map(async (m) => {
  if (!m.locationMatch) return { sessions: 0, totalMinutes: 0 };
  const [row] = await db
    .select({
      sessions:     sql<number>`COUNT(*)`,
      totalMinutes: sql<number>`SUM(COALESCE(${rangeSessions.durationMinutes}, 0))`,
    })
    .from(rangeSessions)
    .where(sql`LOWER(${rangeSessions.location}) LIKE LOWER('%' || ${m.locationMatch} || '%')`);
  return { sessions: row?.sessions ?? 0, totalMinutes: row?.totalMinutes ?? 0 };
}));

function fmt$(n: number | null | undefined) {
  if (n == null) return '—';
  return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtHrs(mins: number) {
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return h > 0 ? `${h}h ${m > 0 ? m + 'm' : ''}`.trim() : `${m}m`;
}

const today = new Date().toISOString().split('T')[0];
---

<Layout title="Ranges" sub="Membership & pricing tracker">
  <slot name="actions" slot="actions">
    <details>
      <summary class="btn btn-primary" style="list-style:none;cursor:pointer;display:inline-flex">+ Add Range</summary>
      <div style="position:absolute;right:0;top:2.5rem;z-index:50;min-width:340px">
        <form method="POST" style="background:var(--bg-card);border:1px solid var(--border);border-radius:0.625rem;padding:1.25rem;display:flex;flex-direction:column;gap:0.875rem;box-shadow:0 8px 24px #0008">
          <input type="hidden" name="_action" value="add" />

          <div><label>Range Name *</label><input name="name" type="text" required placeholder="e.g. Top Gun Range" /></div>

          <div>
            <label>Location Match <span style="color:var(--text-dim);font-weight:400">(used to find sessions)</span></label>
            <input name="locationMatch" type="text" placeholder="e.g. Top Gun — matches your session location field" />
            <div style="font-size:0.7rem;color:var(--text-dim);margin-top:0.25rem">Sessions where location contains this text will be linked to this range.</div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.625rem">
            <div><label>Monthly Fee</label><input name="monthlyFee" type="number" step="0.01" min="0" placeholder="$/mo" /></div>
            <div><label>Hourly Rate</label><input name="hourlyRate" type="number" step="0.01" min="0" placeholder="$/hr" /></div>
            <div><label>Day Rate</label><input name="dayRate" type="number" step="0.01" min="0" placeholder="$/day" /></div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.625rem">
            <div><label>Start Date *</label><input name="startDate" type="date" required value={today} /></div>
            <div><label>End Date</label><input name="endDate" type="date" /></div>
          </div>

          <div>
            <label>Status</label>
            <select name="status">
              <option value="active">Active</option>
              <option value="inactive">Inactive / Cancelled</option>
            </select>
          </div>

          <div><label>Notes</label><textarea name="notes" rows="2"></textarea></div>

          <button type="submit" class="btn btn-primary">Save Range</button>
        </form>
      </div>
    </details>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:52rem">

    {memberships.length === 0 && (
      <div class="empty-state">
        <div style="font-size:2rem;margin-bottom:0.5rem">💳</div>
        <div style="font-weight:600;color:var(--text);margin-bottom:0.25rem">No ranges tracked yet</div>
        <div style="font-size:0.8rem;color:var(--text-dim)">Add a range to compare membership vs. hourly vs. day-rate pricing.</div>
      </div>
    )}

    {memberships.map((m, i) => {
      const stats   = membershipStats[i];
      const allTime = allTimeCounts[i];
      const totalHrs  = stats.totalMinutes / 60;
      const atHrs     = allTime.totalMinutes / 60;

      // Current month costs for each option
      const monthlyOwed = m.monthlyFee ?? null;
      const hourlyCost  = m.hourlyRate  != null ? totalHrs * m.hourlyRate   : null;
      const dayCost     = m.dayRate     != null ? stats.sessions * m.dayRate : null;

      // Break-even thresholds (how much usage makes membership the winner)
      const beVsHourly = m.monthlyFee && m.hourlyRate  ? m.monthlyFee / m.hourlyRate  : null; // hours/mo
      const beVsDay    = m.monthlyFee && m.dayRate     ? m.monthlyFee / m.dayRate     : null; // visits/mo

      // Savings this month vs alternatives (positive = membership wins)
      const saveVsHourly = hourlyCost  != null && monthlyOwed != null ? hourlyCost  - monthlyOwed : null;
      const saveVsDay    = dayCost     != null && monthlyOwed != null ? dayCost     - monthlyOwed : null;

      const isActive = m.status === 'active';
      return (
        <a href={`/memberships/${m.id}`} style="text-decoration:none">
          <div class="card" style={`padding:1.25rem;cursor:pointer;transition:border-color 0.15s;${!isActive ? 'opacity:0.6' : ''}`}
               onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor=''">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap">
              <div>
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                  <span style="font-size:1rem;font-weight:700;color:var(--text)">{m.name}</span>
                  <span style={`font-size:0.6rem;font-weight:700;padding:0.1rem 0.45rem;border-radius:9999px;${isActive ? 'color:#22c55e;background:#22c55e18' : 'color:var(--text-dim);background:var(--bg)'}`}>
                    {isActive ? 'Active' : 'Inactive'}
                  </span>
                </div>
                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.375rem">
                  {m.monthlyFee != null && <span class="pill pill-accent">{fmt$(m.monthlyFee)}/mo</span>}
                  {m.hourlyRate != null && <span class="pill pill-default">{fmt$(m.hourlyRate)}/hr walk-in</span>}
                  {m.dayRate    != null && <span class="pill pill-default">{fmt$(m.dayRate)}/day walk-in</span>}
                </div>
              </div>

              <div style="text-align:right;flex-shrink:0">
                <div style="font-size:0.65rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.05em">This Month</div>
                <div style="font-size:1.1rem;font-weight:700;color:var(--accent)">{stats.sessions} session{stats.sessions !== 1 ? 's' : ''}</div>
                {stats.totalMinutes > 0 && <div style="font-size:0.75rem;color:var(--text-dim)">{fmtHrs(stats.totalMinutes)}</div>}
              </div>
            </div>

            {/* Savings row */}
            {(saveVsHourly != null || saveVsDay != null) && (
              <div style="margin-top:0.875rem;padding-top:0.875rem;border-top:1px solid var(--border);display:flex;gap:1rem;flex-wrap:wrap">
                {saveVsHourly != null && (
                  <div style="display:flex;flex-direction:column;gap:0.125rem">
                    <span style="font-size:0.65rem;color:var(--text-dim)">vs hourly this month</span>
                    <span style={`font-size:0.875rem;font-weight:700;${saveVsHourly >= 0 ? 'color:#22c55e' : 'color:#f87171'}`}>
                      {saveVsHourly >= 0 ? `save ${fmt$(saveVsHourly)}` : `over by ${fmt$(Math.abs(saveVsHourly))}`}
                    </span>
                  </div>
                )}
                {saveVsDay != null && (
                  <div style="display:flex;flex-direction:column;gap:0.125rem">
                    <span style="font-size:0.65rem;color:var(--text-dim)">vs day rate this month</span>
                    <span style={`font-size:0.875rem;font-weight:700;${saveVsDay >= 0 ? 'color:#22c55e' : 'color:#f87171'}`}>
                      {saveVsDay >= 0 ? `save ${fmt$(saveVsDay)}` : `over by ${fmt$(Math.abs(saveVsDay))}`}
                    </span>
                  </div>
                )}
                {beVsHourly != null && (
                  <div style="display:flex;flex-direction:column;gap:0.125rem;margin-left:auto;text-align:right">
                    <span style="font-size:0.65rem;color:var(--text-dim)">break-even</span>
                    <span style="font-size:0.75rem;color:var(--text-dim)">
                      {beVsDay != null && `${Math.ceil(beVsDay)} visits`}
                      {beVsDay != null && beVsHourly != null && ' / '}
                      {beVsHourly != null && `${beVsHourly.toFixed(1)} hrs/mo`}
                    </span>
                  </div>
                )}
              </div>
            )}

            {/* All-time mini stats */}
            <div style="margin-top:0.625rem;display:flex;gap:1rem;flex-wrap:wrap">
              <span style="font-size:0.7rem;color:var(--text-dim)">{allTime.sessions} sessions all-time</span>
              {allTime.totalMinutes > 0 && <span style="font-size:0.7rem;color:var(--text-dim)">{fmtHrs(allTime.totalMinutes)} total time</span>}
              {m.monthlyFee && m.startDate && (() => {
                const months = Math.max(1, Math.round((new Date().getTime() - new Date(m.startDate).getTime()) / (1000 * 60 * 60 * 24 * 30.44)));
                const totalPaid = months * m.monthlyFee;
                return <span style="font-size:0.7rem;color:var(--text-dim)">~{fmt$(totalPaid)} paid total</span>;
              })()}
            </div>
          </div>
        </a>
      );
    })}

  </div>
</Layout>
