---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { firearms } from '../db/schema';

const allFirearms = await db.select().from(firearms).orderBy(firearms.name);

const selectedIds = (Astro.url.searchParams.get('firearms') ?? '')
  .split(',').filter(Boolean).map(Number).filter(n => !isNaN(n));
const drillRows  = Math.min(14, Math.max(4, parseInt(Astro.url.searchParams.get('drills') ?? '8')));
const gunRows    = Math.min(6,  Math.max(2, parseInt(Astro.url.searchParams.get('guns') ?? '3')));

const selected = allFirearms.filter(f => selectedIds.includes(f.id));
// Pad to gunRows with blanks
const gunSlots = Array.from({ length: gunRows }, (_, i) => selected[i] ?? null);
---

<Layout title="Range Card" sub="Print & take to the range">
  <slot name="actions" slot="actions">
    <button onclick="window.print()" class="btn btn-primary">🖨 Print</button>
  </slot>

  <!-- ── Screen config panel (hidden on print) ── -->
  <div class="no-print" style="margin-bottom:1.5rem;max-width:52rem">
    <form method="GET" action="/range-card" class="card" style="padding:1.25rem">
      <div class="form-section">
        <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.75rem">Customize Card</div>
        <div>
          <label>Firearms to Bring</label>
          <div style="display:flex;flex-direction:column;gap:0.375rem;margin-top:0.375rem">
            {allFirearms.map(f => (
              <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.8125rem;cursor:pointer;color:var(--text)">
                <input
                  type="checkbox"
                  name="firearms"
                  value={f.id}
                  checked={selectedIds.includes(f.id)}
                  style="accent-color:var(--accent)"
                  onchange="this.form.requestSubmit()"
                />
                {f.name} <span style="color:var(--text-muted);font-size:0.75rem">({f.caliber})</span>
              </label>
            ))}
            {allFirearms.length === 0 && <span style="font-size:0.8125rem;color:var(--text-dim)">No firearms added yet.</span>}
          </div>
        </div>
        <div class="form-row form-row-2">
          <div>
            <label>Firearm Rows</label>
            <select name="guns" onchange="this.form.requestSubmit()">
              {[2,3,4,5,6].map(n => <option value={n} selected={gunRows === n}>{n}</option>)}
            </select>
          </div>
          <div>
            <label>Drill Rows</label>
            <select name="drills" onchange="this.form.requestSubmit()">
              {[4,6,8,10,12,14].map(n => <option value={n} selected={drillRows === n}>{n}</option>)}
            </select>
          </div>
        </div>
      </div>
    </form>
  </div>

  <!-- ── Printable card ── -->
  <div class="range-card" id="range-card">

    <!-- Header -->
    <div class="rc-header">
      <div class="rc-brand">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="flex-shrink:0">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        ARMORY RANGE CARD
      </div>
      <div class="rc-header-fields">
        <div class="rc-field-group">
          <span class="rc-label">DATE</span>
          <span class="rc-line"></span>
        </div>
        <div class="rc-field-group">
          <span class="rc-label">RANGE / LOCATION</span>
          <span class="rc-line" style="flex:2"></span>
        </div>
        <div class="rc-field-group">
          <span class="rc-label">CONDITIONS</span>
          <span class="rc-line"></span>
        </div>
        <div class="rc-field-group">
          <span class="rc-label">DURATION</span>
          <span class="rc-line" style="flex:0.6"></span>
          <span class="rc-label" style="margin-left:0.25rem">MIN</span>
        </div>
      </div>
    </div>

    <!-- Firearms & Ammo -->
    <div class="rc-section-title">FIREARMS &amp; AMMO</div>
    <table class="rc-table">
      <thead>
        <tr>
          <th style="width:30%">FIREARM</th>
          <th style="width:14%">CALIBER</th>
          <th style="width:28%">AMMO (BRAND / TYPE)</th>
          <th style="width:14%">RDS FIRED</th>
          <th>NOTES</th>
        </tr>
      </thead>
      <tbody>
        {gunSlots.map(f => (
          <tr>
            <td class="rc-prefill">{f ? f.name : ''}</td>
            <td class="rc-prefill">{f ? f.caliber : ''}</td>
            <td></td>
            <td></td>
            <td></td>
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Drills -->
    <div class="rc-section-title" style="margin-top:0.75rem">DRILLS</div>
    <table class="rc-table">
      <thead>
        <tr>
          <th style="width:26%">DRILL NAME</th>
          <th style="width:13%">DISTANCE</th>
          <th style="width:16%">SCORE / TIME</th>
          <th style="width:13%">FIREARM</th>
          <th>NOTES / OBSERVATIONS</th>
        </tr>
      </thead>
      <tbody>
        {Array.from({ length: drillRows }).map(() => (
          <tr><td></td><td></td><td></td><td></td><td></td></tr>
        ))}
      </tbody>
    </table>

    <!-- Notes -->
    <div class="rc-section-title" style="margin-top:0.75rem">NOTES</div>
    <div class="rc-notes">
      {Array.from({ length: 6 }).map(() => <div class="rc-note-line"></div>)}
    </div>

    <!-- Footer -->
    <div class="rc-footer">
      Log this session at your Armory instance after you return from the range.
    </div>

  </div>
</Layout>

<style>
  /* ── Screen styles ── */
  .range-card {
    max-width: 52rem;
    background: #fff;
    color: #000;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .rc-header {
    border-bottom: 2px solid #000;
    padding-bottom: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .rc-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.625rem;
  }

  .rc-header-fields {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .rc-field-group {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    flex: 1;
    min-width: 8rem;
  }

  .rc-label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .rc-line {
    flex: 1;
    border-bottom: 1px solid #000;
    min-width: 3rem;
    height: 1rem;
  }

  .rc-section-title {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    border-bottom: 1.5px solid #000;
    padding-bottom: 0.2rem;
    margin-bottom: 0;
  }

  .rc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.7rem;
  }

  .rc-table th {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: left;
    border: 1px solid #000;
    padding: 0.2rem 0.3rem;
    background: #f0f0f0;
  }

  .rc-table td {
    border: 1px solid #000;
    padding: 0.2rem 0.3rem;
    height: 1.6rem;
    vertical-align: middle;
    font-size: 0.7rem;
    color: #333;
  }

  .rc-prefill {
    font-weight: 600;
    color: #000 !important;
    font-size: 0.7rem !important;
  }

  .rc-notes {
    border: 1px solid #000;
    border-top: none;
  }

  .rc-note-line {
    height: 1.6rem;
    border-top: 1px solid #ccc;
  }

  .rc-notes .rc-note-line:first-child {
    border-top: none;
  }

  .rc-footer {
    margin-top: 0.625rem;
    font-size: 0.55rem;
    color: #666;
    text-align: center;
    letter-spacing: 0.04em;
  }

  /* ── Print overrides ── */
  @media print {
    /* Hide the entire app shell — sidebar, nav, header, config panel */
    .no-print,
    .sidebar,
    .bottom-nav,
    .page-header,
    .pw-warning {
      display: none !important;
    }

    /* Make the main area fill the page */
    body, html { background: #fff !important; }

    .app-shell {
      display: block !important;
    }

    .main-area {
      padding: 0 !important;
      margin: 0 !important;
      overflow: visible !important;
    }

    .page-content {
      padding: 0 !important;
    }

    .range-card {
      border: none !important;
      border-radius: 0 !important;
      padding: 0.5in 0.6in !important;
      max-width: 100% !important;
      page-break-inside: avoid;
    }

    @page {
      size: letter portrait;
      margin: 0;
    }
  }
</style>
