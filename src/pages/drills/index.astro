---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { drills, rangeSessions, firearms } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

const allDrills = await db
  .select({ d: drills, sessionDate: rangeSessions.date, firearmName: firearms.name })
  .from(drills)
  .leftJoin(rangeSessions, eq(drills.sessionId, rangeSessions.id))
  .leftJoin(firearms, eq(drills.firearmId, firearms.id))
  .orderBy(desc(rangeSessions.date));

// Group by drill name
const grouped = new Map<string, typeof allDrills>();
for (const row of allDrills) {
  const name = row.d.name;
  if (!grouped.has(name)) grouped.set(name, []);
  grouped.get(name)!.push(row);
}

// Sort groups: most recently used first
const groups = [...grouped.entries()].sort((a, b) =>
  (b[1][0].sessionDate ?? '').localeCompare(a[1][0].sessionDate ?? '')
);

// Parse a score string to a number for charting
function parseScore(s: string | null): number | null {
  if (!s) return null;
  const m = s.match(/(\d+(?:\.\d+)?)/);
  return m ? parseFloat(m[1]) : null;
}

// Personal records — best numeric score per drill name
const prMap = new Map<string, { value: number; score: string; date: string }>();
for (const [name, rows] of groups) {
  for (const r of rows) {
    const n = parseScore(r.d.score);
    if (n === null || !r.sessionDate) continue;
    const existing = prMap.get(name);
    if (!existing || n > existing.value) prMap.set(name, { value: n, score: r.d.score!, date: r.sessionDate });
  }
}

// Build chart data per group — only groups with ≥2 numeric scores get a chart
const chartData = groups.map(([name, rows]) => {
  const chronological = [...rows].reverse();
  const points = chronological.flatMap(r => {
    const n = parseScore(r.d.score);
    return n !== null && r.sessionDate ? [{ date: r.sessionDate, value: n, label: r.d.score! }] : [];
  });
  const parPoints = chronological.flatMap(r => {
    return r.d.parTime != null && r.sessionDate ? [{ date: r.sessionDate, value: r.d.parTime }] : [];
  });
  return { name, points, parPoints };
}).filter(g => g.points.length >= 2);
---

<Layout title="Drill History" sub="Progress over time">
  <div style="display:flex;flex-direction:column;gap:1.75rem;max-width:52rem">

    {groups.length === 0 && (
      <div class="empty-state">
        <div class="empty-state-icon">🎯</div>
        <div class="empty-state-text">No drills logged yet. Add drills from a session to track progress.</div>
        <a href="/sessions" class="btn btn-primary">View Sessions</a>
      </div>
    )}

    {/* Charts section */}
    {chartData.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">▲</span>
          <span class="section-title">Score Trends</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem">
          {chartData.map(g => (
            <div class="card" style="padding:1.25rem">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.75rem">{g.name}</div>
              <canvas
                data-chart={JSON.stringify({ labels: g.points.map(p => p.date), values: g.points.map(p => p.value), tooltips: g.points.map(p => p.label), parValues: g.parPoints.length >= 2 ? g.parPoints.map(p => p.value) : [], prIndex: (() => { const pr = prMap.get(g.name); if (!pr) return -1; const idx = g.points.findLastIndex(p => p.label === pr.score && p.date === pr.date); return idx; })() })}
                style="width:100%;height:120px"
                height="120"
              ></canvas>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Full history by drill name */}
    {groups.map(([name, rows]) => (
      <div>
        {(() => { const pr = prMap.get(name); return (
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">◎</span>
          <span class="section-title">{name}</span>
          {pr && <span style="font-size:0.65rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:#f59e0b;background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.3);padding:0.1rem 0.45rem;border-radius:9999px;margin-left:0.5rem">PR {pr.score}</span>}
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">{rows.length} {rows.length === 1 ? 'session' : 'sessions'}</span>
        </div>
        ); })()}
        <div class="card card-divide">
          {rows.map(r => {
            const pr = prMap.get(name);
            const isPR = pr && r.d.score === pr.score && r.sessionDate === pr.date;
            return (
            <div class="list-row" style="justify-content:space-between;align-items:flex-start">
              <div style="flex:1">
                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
                  <span style="font-size:0.8125rem;color:var(--text-muted)">{r.sessionDate}</span>
                  {r.d.score && <span class="pill pill-accent">{r.d.score}</span>}
                  {isPR && <span style="font-size:0.6rem;font-weight:800;color:#f59e0b">★ PR</span>}
                  {r.d.parTime != null && <span class="pill pill-default">par {r.d.parTime}s</span>}
                  {r.d.distance && <span class="pill pill-default">{r.d.distance}</span>}
                  {r.firearmName && <span style="font-size:0.7rem;color:var(--text-dim)">{r.firearmName}</span>}
                </div>
                {r.d.notes && <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem">{r.d.notes}</div>}
                {r.d.targetPhotoPath && (
                  <a href={r.d.targetPhotoPath} target="_blank" style="display:inline-block;margin-top:0.5rem">
                    <img src={r.d.targetPhotoPath} alt="Target" style="max-width:6rem;max-height:4.5rem;object-fit:cover;border-radius:0.25rem;border:1px solid var(--border)" />
                  </a>
                )}
              </div>
              <a href={`/sessions/${r.d.sessionId}`} style="font-size:0.7rem;color:var(--accent);text-decoration:none;white-space:nowrap;margin-left:0.75rem">View →</a>
            </div>
            );
          })}
        </div>
      </div>
    ))}

  </div>
</Layout>

<script>
  // Render charts after page load using CSS variable colors
  document.addEventListener('DOMContentLoaded', () => {
    const style = getComputedStyle(document.documentElement);
    const accent = style.getPropertyValue('--accent').trim() || '#06b6d4';
    const border = style.getPropertyValue('--border').trim() || '#1e2433';

    document.querySelectorAll<HTMLCanvasElement>('canvas[data-chart]').forEach(canvas => {
      const { labels, values, tooltips, parValues, prIndex } = JSON.parse(canvas.dataset.chart!);
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const w = canvas.offsetWidth || 300;
      const h = canvas.offsetHeight || 120;
      canvas.width = w * devicePixelRatio;
      canvas.height = h * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);

      const pad = { top: 10, right: 10, bottom: 28, left: 36 };
      const chartW = w - pad.left - pad.right;
      const chartH = h - pad.top - pad.bottom;
      const allVals = [...values, ...(parValues.length ? parValues : [])];
      const min = Math.min(...allVals);
      const max = Math.max(...allVals);
      const range = max - min || 1;

      const xPos = (i: number, len: number) => pad.left + (i / (len - 1)) * chartW;
      const yPos = (v: number) => pad.top + chartH - ((v - min) / range) * chartH;

      // Grid lines
      ctx.strokeStyle = border;
      ctx.lineWidth = 1;
      [0, 0.5, 1].forEach(t => {
        const y = pad.top + t * chartH;
        ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + chartW, y); ctx.stroke();
        ctx.fillStyle = '#6b7280';
        ctx.font = `10px ui-monospace,monospace`;
        ctx.textAlign = 'right';
        ctx.fillText((max - t * range).toFixed(1), pad.left - 4, y + 3.5);
      });

      const drawSeries = (vals: number[], color: string, dashed: boolean) => {
        const len = vals.length;
        // Area fill (only for primary)
        if (!dashed) {
          ctx.beginPath();
          ctx.moveTo(xPos(0, len), yPos(vals[0]));
          vals.forEach((v, i) => { if (i > 0) ctx.lineTo(xPos(i, len), yPos(v)); });
          ctx.lineTo(xPos(len - 1, len), pad.top + chartH);
          ctx.lineTo(xPos(0, len), pad.top + chartH);
          ctx.closePath();
          ctx.fillStyle = color + '22';
          ctx.fill();
        }
        // Line
        ctx.beginPath();
        ctx.strokeStyle = color;
        ctx.lineWidth = dashed ? 1.5 : 2;
        ctx.lineJoin = 'round';
        if (dashed) ctx.setLineDash([4, 3]);
        vals.forEach((v, i) => i === 0 ? ctx.moveTo(xPos(i, len), yPos(v)) : ctx.lineTo(xPos(i, len), yPos(v)));
        ctx.stroke();
        ctx.setLineDash([]);
        // Dots
        vals.forEach((v, i) => {
          ctx.beginPath();
          ctx.arc(xPos(i, len), yPos(v), 3, 0, Math.PI * 2);
          ctx.fillStyle = color;
          ctx.fill();
          ctx.strokeStyle = '#0b0e14';
          ctx.lineWidth = 1.5;
          ctx.stroke();
        });
      };

      drawSeries(values, accent, false);
      if (parValues.length >= 2) drawSeries(parValues, '#f59e0b', true);

      // PR gold ring
      if (prIndex >= 0 && prIndex < values.length) {
        const px = xPos(prIndex, values.length);
        const py = yPos(values[prIndex]);
        ctx.beginPath();
        ctx.arc(px, py, 6, 0, Math.PI * 2);
        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // X-axis labels (primary series)
      values.forEach((_: number, i: number) => {
        if (i === 0 || i === values.length - 1 || values.length <= 6) {
          ctx.fillStyle = '#6b7280';
          ctx.font = `9px ui-sans-serif,sans-serif`;
          ctx.textAlign = 'center';
          ctx.fillText(labels[i].slice(5), xPos(i, values.length), h - 6);
        }
      });
    });
  });
</script>
