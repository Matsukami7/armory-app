---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { receipts } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    await db.delete(receipts).where(eq(receipts.id, parseInt(form.get('id') as string)));
  }

  return Astro.redirect('/receipts');
}

const url = new URL(Astro.request.url);
const filterCategory = url.searchParams.get('category') ?? '';

const allReceipts = await db.select().from(receipts).orderBy(desc(receipts.date), desc(receipts.id));

const shown = filterCategory
  ? allReceipts.filter(r => r.category === filterCategory)
  : allReceipts;

const today = new Date();
const monthKey = today.toISOString().slice(0, 7); // YYYY-MM
const yearKey  = today.toISOString().slice(0, 4); // YYYY

const sum = (rows: typeof allReceipts) => rows.reduce((s, r) => s + (r.total ?? 0), 0);

const monthTotal = sum(allReceipts.filter(r => r.date.startsWith(monthKey)));
const yearTotal  = sum(allReceipts.filter(r => r.date.startsWith(yearKey)));
const allTotal   = sum(allReceipts);

// Category breakdown across all receipts
const CATEGORIES = ['ammo', 'range_fee', 'gear', 'firearm', 'accessory', 'other'] as const;
const byCategory: Record<string, number> = {};
for (const cat of CATEGORIES) byCategory[cat] = sum(allReceipts.filter(r => r.category === cat));

const CATEGORY_LABEL: Record<string, string> = {
  ammo: 'Ammo', range_fee: 'Range Fee', gear: 'Gear',
  firearm: 'Firearm', accessory: 'Accessory', other: 'Other',
};

const CATEGORY_ICON: Record<string, string> = {
  ammo: '🎯', range_fee: '🎫', gear: '🎒',
  firearm: '🔫', accessory: '🔭', other: '📄',
};

const money = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
---

<Layout title="Receipts" sub={`${allReceipts.length} receipt${allReceipts.length !== 1 ? 's' : ''} · ${money(allTotal)} all-time`}>
  <slot name="actions" slot="actions">
    <a href="/receipts/new" class="btn btn-primary">+ New Receipt</a>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.75rem;max-width:60rem">

    <!-- Totals -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:0.75rem">
      <div class="stat-card">
        <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted)">This Month</div>
        <div style="font-size:1.5rem;font-weight:800;color:var(--text);margin-top:0.25rem">{money(monthTotal)}</div>
      </div>
      <div class="stat-card">
        <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted)">This Year</div>
        <div style="font-size:1.5rem;font-weight:800;color:var(--text);margin-top:0.25rem">{money(yearTotal)}</div>
      </div>
      <div class="stat-card">
        <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted)">All-Time</div>
        <div style="font-size:1.5rem;font-weight:800;color:var(--text);margin-top:0.25rem">{money(allTotal)}</div>
      </div>
    </div>

    <!-- Category filter tabs -->
    {allReceipts.length > 0 && (
      <div class="filter-tabs">
        <a href="/receipts" class={`filter-tab ${!filterCategory ? 'active' : ''}`}>
          All <span style="opacity:0.6">· {money(allTotal)}</span>
        </a>
        {CATEGORIES.filter(c => byCategory[c] > 0).map(cat => (
          <a href={`/receipts?category=${cat}`} class={`filter-tab ${filterCategory === cat ? 'active' : ''}`}>
            {CATEGORY_ICON[cat]} {CATEGORY_LABEL[cat]} <span style="opacity:0.6">· {money(byCategory[cat])}</span>
          </a>
        ))}
      </div>
    )}

    {shown.length === 0 && (
      <div class="empty-state">
        <div class="empty-state-icon">🧾</div>
        <div class="empty-state-text">
          {filterCategory ? `No receipts in this category yet.` : 'No receipts yet. Upload one to start tracking expenses.'}
        </div>
      </div>
    )}

    {shown.length > 0 && (
      <div class="card card-divide">
        {shown.map(r => (
          <div class="list-row" style="justify-content:space-between;align-items:flex-start;gap:1rem">
            <div style="flex:1;min-width:0;display:flex;gap:0.875rem;align-items:flex-start">
              {r.photoPath ? (
                <a href={r.photoPath} target="_blank" rel="noopener" style="flex-shrink:0">
                  {/\.(pdf|doc|docx|txt)$/i.test(r.photoPath) ? (
                    <div style="width:3rem;height:3rem;border:1px solid var(--border);border-radius:0.375rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;background:var(--bg-hover)">📄</div>
                  ) : (
                    <img src={r.photoPath} alt="" style="width:3rem;height:3rem;object-fit:cover;border-radius:0.375rem;border:1px solid var(--border)" />
                  )}
                </a>
              ) : (
                <div style="width:3rem;height:3rem;border:1px solid var(--border);border-radius:0.375rem;display:flex;align-items:center;justify-content:center;font-size:1.25rem;background:var(--bg-hover);flex-shrink:0;opacity:0.5">{CATEGORY_ICON[r.category] ?? '📄'}</div>
              )}
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                  <span style="font-size:0.875rem;font-weight:700;color:var(--text)">{money(r.total)}</span>
                  <span class="pill pill-accent" style="font-size:0.6rem">{CATEGORY_ICON[r.category]} {CATEGORY_LABEL[r.category]}</span>
                  <span style="font-size:0.7rem;color:var(--text-dim)">{r.date}</span>
                </div>
                {r.vendor && <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.1rem">{r.vendor}</div>}
                {r.notes && <div style="font-size:0.72rem;color:var(--text-dim);margin-top:0.25rem">{r.notes}</div>}
              </div>
            </div>
            <div style="display:flex;gap:0.5rem;flex-shrink:0;align-items:center">
              <a href={`/receipts/${r.id}/edit`} class="btn btn-secondary btn-sm">Edit</a>
              <form method="POST" onsubmit="return confirm('Delete this receipt?')">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={r.id} />
                <button type="submit" class="btn-delete">✕</button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )}

  </div>
</Layout>
