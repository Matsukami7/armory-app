---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { receipts, rangeSessions, ammoPurchases, ammoInventory } from '../../db/schema';
import { saveUpload } from '../../lib/uploads';
import { desc, eq } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const file = form.get('file') as File | null;
  let photoPath: string | null = null;
  if (file && file.size > 0) {
    photoPath = await saveUpload(file, 'receipts');
  }

  const sessionIdRaw      = form.get('sessionId') as string;
  const ammoPurchaseIdRaw = form.get('ammoPurchaseId') as string;
  const sessionId         = sessionIdRaw ? parseInt(sessionIdRaw) : null;
  const ammoPurchaseId    = ammoPurchaseIdRaw ? parseInt(ammoPurchaseIdRaw) : null;
  const returnTo          = form.get('returnTo') as string;

  await db.insert(receipts).values({
    date:           form.get('date') as string,
    vendor:         form.get('vendor') as string || null,
    total:          parseFloat(form.get('total') as string),
    category:       form.get('category') as string || 'other',
    photoPath,
    notes:          form.get('notes') as string || null,
    sessionId:      sessionId && !isNaN(sessionId) ? sessionId : null,
    ammoPurchaseId: ammoPurchaseId && !isNaN(ammoPurchaseId) ? ammoPurchaseId : null,
  });

  if (returnTo && returnTo.startsWith('/')) return Astro.redirect(returnTo);
  if (sessionId) return Astro.redirect(`/sessions/${sessionId}`);
  return Astro.redirect('/receipts');
}

const today = new Date().toISOString().split('T')[0];

const url = new URL(Astro.request.url);
const preselectedSession      = url.searchParams.get('session');
const preselectedAmmoPurchase = url.searchParams.get('ammoPurchase');
const returnTo                = url.searchParams.get('returnTo') ?? '';

const allSessions = await db
  .select({ id: rangeSessions.id, date: rangeSessions.date, location: rangeSessions.location })
  .from(rangeSessions)
  .orderBy(desc(rangeSessions.date));

const allAmmoPurchases = await db
  .select({
    pid:     ammoPurchases.id,
    pdate:   ammoPurchases.date,
    pqty:    ammoPurchases.quantity,
    pcost:   ammoPurchases.totalCost,
    brand:   ammoInventory.brand,
    caliber: ammoInventory.caliber,
    grain:   ammoInventory.grain,
  })
  .from(ammoPurchases)
  .leftJoin(ammoInventory, eq(ammoPurchases.ammoId, ammoInventory.id))
  .orderBy(desc(ammoPurchases.date));
---

<Layout title="New Receipt" sub="Log a range or gear purchase" backHref="/receipts">

  <form method="POST" enctype="multipart/form-data" class="card" style="padding:1.5rem;max-width:42rem">
    <input type="hidden" name="returnTo" value={returnTo} />
    <div class="form-section">

      <div class="form-row form-row-2">
        <div><label>Date *</label><input name="date" type="date" required value={today} /></div>
        <div><label>Total ($) *</label><input name="total" type="number" min="0" step="0.01" required placeholder="42.50" /></div>
      </div>

      <div class="form-row form-row-2">
        <div><label>Vendor</label><input name="vendor" type="text" placeholder="Range name, store, etc." /></div>
        <div>
          <label>Category</label>
          <select name="category">
            <option value="ammo">🎯 Ammo</option>
            <option value="range_fee">🎫 Range Fee</option>
            <option value="gear">🎒 Gear</option>
            <option value="firearm">🔫 Firearm</option>
            <option value="accessory">🔭 Accessory</option>
            <option value="other" selected>📄 Other</option>
          </select>
        </div>
      </div>

      <div>
        <label>Link to Session</label>
        <select name="sessionId">
          <option value="">None</option>
          {allSessions.map(s => (
            <option value={s.id} selected={preselectedSession === String(s.id)}>
              {s.date}{s.location ? ` — ${s.location}` : ''}
            </option>
          ))}
        </select>
        <div style="font-size:0.65rem;color:var(--text-dim);margin-top:0.25rem">
          Optional — receipts linked to a session appear on that session's page.
        </div>
      </div>

      <div>
        <label>Link to Ammo Purchase</label>
        <select name="ammoPurchaseId">
          <option value="">None</option>
          {allAmmoPurchases.map(p => (
            <option value={p.pid} selected={preselectedAmmoPurchase === String(p.pid)}>
              {p.pdate} — {p.brand ?? '?'} {p.grain ? `${p.grain}gr ` : ''}{p.caliber ?? ''} ({p.pqty}rds{p.pcost ? ` · $${p.pcost.toFixed(2)}` : ''})
            </option>
          ))}
        </select>
        <div style="font-size:0.65rem;color:var(--text-dim);margin-top:0.25rem">
          Optional — receipts linked to an ammo purchase show on that ammo entry's edit page.
        </div>
      </div>

      <div>
        <label>Receipt Photo / PDF</label>
        <input name="file" type="file" accept="image/*,.pdf,.jpg,.jpeg,.png,.webp,.heic" />
        <div style="font-size:0.65rem;color:var(--text-dim);margin-top:0.25rem">
          jpg, png, webp, heic, or pdf — stored in data/uploads/receipts/
        </div>
      </div>

      <div><label>Notes</label><textarea name="notes" rows="2" placeholder="What was on it? Range fee + box of 9mm, etc."></textarea></div>

      <div style="display:flex;gap:0.5rem">
        <button type="submit" class="btn btn-primary">Save Receipt</button>
        <a href="/receipts" class="btn btn-secondary">Cancel</a>
      </div>
    </div>
  </form>

</Layout>
