---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { firearms, rangeSessions, ammoInventory, sessionFirearms, maintenanceLogs, gear } from '../db/schema';
import { sql, sum, count, eq, and, isNotNull, or, desc } from 'drizzle-orm';

const firearmCount   = (await db.select({ c: count() }).from(firearms))[0].c;
const sessionCount   = (await db.select({ c: count() }).from(rangeSessions))[0].c;
const totalRounds    = Number((await db.select({ s: sum(sessionFirearms.roundsFired) }).from(sessionFirearms))[0].s ?? 0);
const allFirearmData = await db.select().from(firearms);
const totalInvest    = allFirearmData.reduce((s, f) => s + (f.purchasePrice ?? 0), 0);
const collectionValue = allFirearmData.reduce((s, f) => s + (f.currentValue ?? f.purchasePrice ?? 0), 0);
const recentSessions = await db.select().from(rangeSessions).orderBy(sql`date DESC`).limit(5);
const lowAmmo        = await db.select().from(ammoInventory).where(sql`low_stock_threshold > 0 AND quantity <= low_stock_threshold`).orderBy(sql`quantity ASC`);
const lowGear        = await db.select().from(gear).where(sql`low_stock_threshold > 0 AND quantity <= low_stock_threshold`).orderBy(sql`name ASC`);

// Range spend: sum of rounds_fired * cost_per_round for all sessions with ammo linked
const spendRows = await db
  .select({ rounds: sessionFirearms.roundsFired, cpr: ammoInventory.costPerRound })
  .from(sessionFirearms)
  .leftJoin(ammoInventory, eq(sessionFirearms.ammoId, ammoInventory.id))
  .where(isNotNull(sessionFirearms.ammoId));
const rangeSpend = spendRows.reduce((s, r) => s + r.rounds * (r.cpr ?? 0), 0);

// Maintenance due: firearms with any service interval set
const firearmsWithInterval = await db.select().from(firearms).where(
  and(eq(firearms.status, 'active'), or(isNotNull(firearms.serviceIntervalRounds), isNotNull(firearms.cleanIntervalDays)))
);
const maintenanceDue: { firearm: typeof firearmsWithInterval[0], roundsSince: number, daysSince: number, reason: string }[] = [];

const todayMs = Date.now();
for (const f of firearmsWithInterval) {
  const [roundRow] = await db
    .select({ total: sum(sessionFirearms.roundsFired) })
    .from(sessionFirearms)
    .where(eq(sessionFirearms.firearmId, f.id));
  const total = Number(roundRow?.total ?? 0);

  const [lastCleaning] = await db
    .select()
    .from(maintenanceLogs)
    .where(and(eq(maintenanceLogs.firearmId, f.id), eq(maintenanceLogs.type, 'cleaning')))
    .orderBy(desc(maintenanceLogs.date))
    .limit(1);

  const roundsSince = total - (lastCleaning?.roundCount ?? 0);
  const daysSince = lastCleaning?.date
    ? Math.floor((todayMs - new Date(lastCleaning.date).getTime()) / 86_400_000)
    : Infinity;

  const roundsDue = f.serviceIntervalRounds != null && roundsSince >= f.serviceIntervalRounds;
  const daysDue   = f.cleanIntervalDays != null && daysSince !== Infinity && daysSince >= f.cleanIntervalDays;
  const neverCleaned = f.cleanIntervalDays != null && daysSince === Infinity;

  if (roundsDue || daysDue || neverCleaned) {
    const reasons: string[] = [];
    if (roundsDue) reasons.push(`${(roundsSince - f.serviceIntervalRounds!).toLocaleString()} rds overdue`);
    if (daysDue)   reasons.push(`${daysSince - f.cleanIntervalDays!}d overdue`);
    if (neverCleaned) reasons.push('never cleaned');
    maintenanceDue.push({ firearm: f, roundsSince, daysSince: daysSince === Infinity ? -1 : daysSince, reason: reasons.join(' · ') });
  }
}
---

<Layout title="Command Center" sub="Tactical inventory overview">
  <slot name="actions" slot="actions">
    <div style="display:flex;gap:0.5rem">
      <a href="/log" class="btn btn-primary">⚡ Quick Log</a>
      <a href="/sessions/new" class="btn btn-secondary">+ Log Session</a>
      <a href="/firearms/new" class="btn btn-secondary">+ Add Firearm</a>
    </div>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.75rem">

    <!-- Stat cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem">

      <div class="stat-card">
        <div>
          <div class="stat-card-label">Total Firearms</div>
          <div class="stat-card-value">{firearmCount}</div>
          <div class="stat-card-sub">in vault</div>
        </div>
        <div class="stat-card-icon" style="background:rgba(6,182,212,0.1);color:#06b6d4">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-card-label">Range Sessions</div>
          <div class="stat-card-value">{sessionCount}</div>
          <div class="stat-card-sub">logged</div>
        </div>
        <div class="stat-card-icon" style="background:rgba(168,85,247,0.1);color:#a855f7">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
          </svg>
        </div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-card-label">Total Rounds</div>
          <div class="stat-card-value" style="color:#f97316">{totalRounds.toLocaleString()}</div>
          <div class="stat-card-sub">fired all time</div>
        </div>
        <div class="stat-card-icon" style="background:rgba(249,115,22,0.1);color:#f97316">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
      </div>

      <div class="stat-card">
        <div>
          <div class="stat-card-label">Collection Value</div>
          <div class="stat-card-value" style="color:#22c55e">${collectionValue.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}</div>
          <div class="stat-card-sub">{totalInvest > 0 ? `paid $${totalInvest.toLocaleString('en-US', {maximumFractionDigits:0})}` : 'est. current value'}</div>
        </div>
        <div class="stat-card-icon" style="background:rgba(34,197,94,0.1);color:#22c55e">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>

      {rangeSpend > 0 && (
        <div class="stat-card">
          <div>
            <div class="stat-card-label">Range Spend</div>
            <div class="stat-card-value" style="color:#f59e0b">${rangeSpend.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</div>
            <div class="stat-card-sub">ammo all time</div>
          </div>
          <div class="stat-card-icon" style="background:rgba(245,158,11,0.1);color:#f59e0b">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75" />
            </svg>
          </div>
        </div>
      )}

    </div>

    <!-- Maintenance due -->
    <div>
      <div class="section-header">
        <span style={`color:${maintenanceDue.length > 0 ? '#ef4444' : 'var(--text-dim)'};font-size:0.75rem`}>●</span>
        <span class="section-title">Maintenance Due</span>
      </div>
      {maintenanceDue.length === 0 ? (
        <div class="card" style="padding:1.5rem;text-align:center;color:var(--text-dim);font-size:0.8125rem">
          {firearmsWithInterval.length === 0
            ? 'Set a service interval on a firearm to track maintenance.'
            : 'All firearms are within service interval.'}
        </div>
      ) : (
        <div class="card card-divide">
          {maintenanceDue.map(({ firearm, roundsSince, daysSince, reason }) => (
            <a href={`/firearms/${firearm.id}`} class="list-row list-row-link" style="justify-content:space-between">
              <div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--text)">{firearm.name}</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">
                  {roundsSince > 0 ? `${roundsSince.toLocaleString()} rds` : '0 rds'} since cleaning
                  {daysSince >= 0 ? ` · ${daysSince}d ago` : ''}
                </div>
              </div>
              <span style="font-size:0.72rem;font-weight:700;color:#ef4444;white-space:nowrap;text-align:right">{reason}</span>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Low ammo -->
    {lowAmmo.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:#f97316;font-size:0.75rem">▲</span>
          <span class="section-title">Low Ammo Alerts</span>
        </div>
        <div class="card card-divide">
          {lowAmmo.map(a => (
            <a href="/ammo" class="list-row list-row-link" style="justify-content:space-between">
              <div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--text)">{a.brand} {a.grain ? `${a.grain}gr` : ''} {a.caliber}</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">{a.type}</div>
              </div>
              <span style={`font-size:1rem;font-weight:800;color:${a.quantity < 50 ? '#f87171' : '#f97316'}`}>{a.quantity}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Low gear stock -->
    {lowGear.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:#f97316;font-size:0.75rem">▲</span>
          <span class="section-title">Low Gear Stock</span>
        </div>
        <div class="card card-divide">
          {lowGear.map(g => (
            <a href="/gear" class="list-row list-row-link" style="justify-content:space-between">
              <div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--text)">{g.name}</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">alert at {g.lowStockThreshold} {g.unit}</div>
              </div>
              <span style="font-size:1rem;font-weight:800;color:#f87171">{g.quantity} <span style="font-size:0.65rem;font-weight:400;color:var(--text-muted)">{g.unit}</span></span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Recent sessions -->
    {recentSessions.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">◎</span>
          <span class="section-title">Recent Sessions</span>
        </div>
        <div class="card card-divide">
          {recentSessions.map(s => (
            <a href={`/sessions/${s.id}`} class="list-row list-row-link" style="justify-content:space-between">
              <div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--text)">{s.date}</div>
                <div style="font-size:0.75rem;color:var(--text-muted)">{s.location ?? 'No location'}{s.durationMinutes ? ` · ${s.durationMinutes}min` : ''}</div>
              </div>
              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text-dim)">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    )}

    {firearmCount === 0 && sessionCount === 0 && (
      <div class="empty-state">
        <div class="empty-state-icon">🎯</div>
        <div class="empty-state-text">Add your first firearm to get started.</div>
        <a href="/firearms/new" class="btn btn-primary">Add Firearm</a>
      </div>
    )}

  </div>
</Layout>
