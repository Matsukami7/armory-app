---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { shotGroups, firearms, ammoInventory, rangeSessions } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { saveUpload } from '../../lib/uploads';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'add') {
    let photoPath: string | null = null;
    const photo = form.get('photo') as File | null;
    if (photo && photo.size > 0) {
      photoPath = await saveUpload(photo, 'targets');
    }
    await db.insert(shotGroups).values({
      sessionId:    form.get('sessionId') ? parseInt(form.get('sessionId') as string) : null,
      firearmId:    form.get('firearmId') ? parseInt(form.get('firearmId') as string) : null,
      ammoId:       form.get('ammoId')    ? parseInt(form.get('ammoId') as string)    : null,
      date:         form.get('date') as string,
      distance:     form.get('distance')  ? parseInt(form.get('distance') as string)  : null,
      distanceUnit: form.get('distanceUnit') as string || 'yards',
      groupSize:    parseFloat(form.get('groupSize') as string),
      groupUnit:    form.get('groupUnit') as string || 'inches',
      shotCount:    form.get('shotCount') ? parseInt(form.get('shotCount') as string) : null,
      notes:        form.get('notes') as string || null,
      photoPath,
    });
  }

  if (action === 'delete') {
    await db.delete(shotGroups).where(eq(shotGroups.id, parseInt(form.get('id') as string)));
  }

  return Astro.redirect('/groups');
}

const rows = await db
  .select({ g: shotGroups, gun: firearms, ammo: ammoInventory, session: rangeSessions })
  .from(shotGroups)
  .leftJoin(firearms,       eq(shotGroups.firearmId, firearms.id))
  .leftJoin(ammoInventory,  eq(shotGroups.ammoId,    ammoInventory.id))
  .leftJoin(rangeSessions,  eq(shotGroups.sessionId, rangeSessions.id))
  .orderBy(desc(shotGroups.date));

const allGuns = await db.select().from(firearms).orderBy(firearms.name);
const allAmmo = await db.select().from(ammoInventory).orderBy(ammoInventory.caliber);
const today   = new Date().toISOString().split('T')[0];

// Group by firearm for trend charts — only guns with ≥2 entries at the same distance
const byGun = new Map<number, typeof rows>();
for (const r of rows) {
  if (!r.gun) continue;
  const key = r.gun.id;
  if (!byGun.has(key)) byGun.set(key, []);
  byGun.get(key)!.push(r);
}

const trends = [...byGun.entries()].flatMap(([, gunRows]) => {
  const byDist = new Map<string, typeof rows>();
  for (const r of gunRows) {
    const key = `${r.g.distance ?? '?'}${r.g.distanceUnit}`;
    if (!byDist.has(key)) byDist.set(key, []);
    byDist.get(key)!.push(r);
  }
  return [...byDist.entries()]
    .filter(([, pts]) => pts.length >= 2)
    .map(([distLabel, pts]) => ({
      label: `${pts[0].gun?.name} · ${distLabel}`,
      points: [...pts].reverse().map(r => ({ date: r.g.date, value: r.g.groupSize, unit: r.g.groupUnit })),
    }));
});
---

<Layout title="Shot Groups" sub="Precision tracking over time">
  <div style="display:flex;flex-direction:column;gap:1.75rem;max-width:52rem">

    <!-- Trend charts -->
    {trends.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">▼</span>
          <span class="section-title">Group Size Trends</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">lower is better</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem">
          {trends.map(t => (
            <div class="card" style="padding:1.25rem">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.75rem">{t.label}</div>
              <canvas
                data-chart={JSON.stringify({ labels: t.points.map(p => p.date), values: t.points.map(p => p.value), unit: t.points[0]?.unit ?? 'in' })}
                style="width:100%;height:120px" height="120"
              ></canvas>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- History -->
    {rows.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">◎</span>
          <span class="section-title">All Groups</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">{rows.length} recorded</span>
        </div>
        <div class="card card-divide">
          {rows.map(r => (
            <div class="list-row" style="justify-content:space-between;align-items:flex-start;gap:1rem">
              <div style="flex:1">
                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
                  <span style="font-size:0.8125rem;color:var(--text-muted)">{r.g.date}</span>
                  <span style="font-size:1rem;font-weight:800;color:var(--accent)">{r.g.groupSize}{r.g.groupUnit === 'inches' ? '"' : r.g.groupUnit === 'moa' ? ' MOA' : ' mm'}</span>
                  {r.g.distance && <span class="pill pill-default">{r.g.distance}{r.g.distanceUnit === 'meters' ? 'm' : 'yd'}</span>}
                  {r.g.shotCount && <span style="font-size:0.72rem;color:var(--text-dim)">{r.g.shotCount} shots</span>}
                </div>
                <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:0.25rem">
                  {r.gun  && <span style="font-size:0.75rem;color:var(--text-muted)">{r.gun.name}</span>}
                  {r.ammo && <span style="font-size:0.72rem;color:var(--text-dim)">{r.ammo.brand} {r.ammo.grain ? `${r.ammo.grain}gr` : ''}</span>}
                  {r.session && <a href={`/sessions/${r.g.sessionId}`} style="font-size:0.7rem;color:var(--accent)">Session →</a>}
                </div>
                {r.g.notes && <div style="font-size:0.72rem;color:var(--text-dim);margin-top:0.2rem">{r.g.notes}</div>}
                {r.g.photoPath && (
                  <a href={r.g.photoPath} target="_blank" style="display:inline-block;margin-top:0.5rem">
                    <img src={r.g.photoPath} alt="Group" style="max-width:7rem;max-height:5rem;object-fit:cover;border-radius:0.25rem;border:1px solid var(--border)" />
                  </a>
                )}
              </div>
              <form method="POST" onsubmit="return confirm('Delete this group entry?')">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={r.g.id} />
                <button type="submit" class="btn-delete">✕</button>
              </form>
            </div>
          ))}
        </div>
      </div>
    )}

    {rows.length === 0 && (
      <div class="empty-state">
        <div class="empty-state-icon">🎯</div>
        <div class="empty-state-text">No shot groups recorded yet. Log your first group below.</div>
      </div>
    )}

    <!-- Add form -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">+</span>
        <span class="section-title">Log Group</span>
      </div>
      <form method="POST" enctype="multipart/form-data" class="card" style="padding:1.5rem">
        <input type="hidden" name="_action" value="add" />
        <div class="form-section">
          <div class="form-row form-row-2">
            <div><label>Date *</label><input name="date" type="date" required value={today} /></div>
            <div>
              <label>Firearm</label>
              <select name="firearmId">
                <option value="">— None —</option>
                {allGuns.map(g => <option value={g.id}>{g.name}</option>)}
              </select>
            </div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Group Size *</label><input name="groupSize" type="number" step="0.01" min="0.001" required placeholder="0.75" /></div>
            <div>
              <label>Unit</label>
              <select name="groupUnit">
                <option value="inches">Inches</option>
                <option value="moa">MOA</option>
                <option value="mm">mm</option>
              </select>
            </div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Distance</label><input name="distance" type="number" min="1" placeholder="100" /></div>
            <div>
              <label>Distance Unit</label>
              <select name="distanceUnit">
                <option value="yards">Yards</option>
                <option value="meters">Meters</option>
              </select>
            </div>
          </div>
          <div class="form-row form-row-2">
            <div>
              <label>Ammo</label>
              <select name="ammoId">
                <option value="">— None —</option>
                {allAmmo.map(a => <option value={a.id}>{a.brand} {a.grain ? `${a.grain}gr ` : ''}{a.caliber}</option>)}
              </select>
            </div>
            <div><label>Shot Count</label><input name="shotCount" type="number" min="1" placeholder="5" /></div>
          </div>
          <div><label>Notes</label><input name="notes" type="text" placeholder="Conditions, position, etc." /></div>
          <div><label>Photo</label><input name="photo" type="file" accept="image/*" /></div>
          <button type="submit" class="btn btn-primary">Log Group</button>
        </div>
      </form>
    </div>

  </div>
</Layout>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const style = getComputedStyle(document.documentElement);
  const accent = style.getPropertyValue('--accent').trim() || '#06b6d4';
  const border = style.getPropertyValue('--border').trim() || '#1e2433';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-chart]').forEach(canvas => {
    const { labels, values, unit } = JSON.parse(canvas.dataset.chart!);
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const w = canvas.offsetWidth || 300;
    const h = canvas.offsetHeight || 120;
    canvas.width  = w * devicePixelRatio;
    canvas.height = h * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);

    const pad = { top: 10, right: 10, bottom: 28, left: 40 };
    const cw = w - pad.left - pad.right;
    const ch = h - pad.top - pad.bottom;
    const min = Math.min(...values);
    const max = Math.max(...values);
    const range = max - min || 1;

    const xPos = (i: number) => pad.left + (i / (values.length - 1)) * cw;
    const yPos = (v: number) => pad.top + ch - ((v - min) / range) * ch;

    // Grid
    ctx.strokeStyle = border; ctx.lineWidth = 1;
    [0, 0.5, 1].forEach(t => {
      const y = pad.top + t * ch;
      ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + cw, y); ctx.stroke();
      ctx.fillStyle = '#6b7280'; ctx.font = '10px ui-monospace,monospace'; ctx.textAlign = 'right';
      const val = max - t * range;
      ctx.fillText(`${val.toFixed(2)}${unit === 'inches' ? '"' : unit === 'moa' ? ' MOA' : 'mm'}`, pad.left - 4, y + 3.5);
    });

    // Area
    ctx.beginPath();
    ctx.moveTo(xPos(0), yPos(values[0]));
    values.forEach((v: number, i: number) => { if (i > 0) ctx.lineTo(xPos(i), yPos(v)); });
    ctx.lineTo(xPos(values.length - 1), pad.top + ch);
    ctx.lineTo(xPos(0), pad.top + ch);
    ctx.closePath();
    ctx.fillStyle = accent + '22'; ctx.fill();

    // Line
    ctx.beginPath(); ctx.strokeStyle = accent; ctx.lineWidth = 2; ctx.lineJoin = 'round';
    values.forEach((v: number, i: number) => i === 0 ? ctx.moveTo(xPos(i), yPos(v)) : ctx.lineTo(xPos(i), yPos(v)));
    ctx.stroke();

    // Dots + best marker
    const bestVal = Math.min(...values);
    values.forEach((v: number, i: number) => {
      const isBest = v === bestVal;
      ctx.beginPath();
      ctx.arc(xPos(i), yPos(v), isBest ? 5 : 3, 0, Math.PI * 2);
      ctx.fillStyle = isBest ? '#22c55e' : accent;
      ctx.fill();
      ctx.strokeStyle = '#0b0e14'; ctx.lineWidth = 1.5; ctx.stroke();
    });

    // X labels
    values.forEach((_: number, i: number) => {
      if (i === 0 || i === values.length - 1 || values.length <= 6) {
        ctx.fillStyle = '#6b7280'; ctx.font = '9px ui-sans-serif,sans-serif'; ctx.textAlign = 'center';
        ctx.fillText(labels[i].slice(5), xPos(i), h - 6);
      }
    });
  });
});
</script>
