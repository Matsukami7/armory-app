---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { arBuilds, arBuildParts } from '../../db/schema';
import { eq } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');
  if (action === 'delete') {
    await db.delete(arBuilds).where(eq(arBuilds.id, parseInt(form.get('id') as string)));
  }
  return Astro.redirect('/builds');
}

const builds = await db.select().from(arBuilds).orderBy(arBuilds.createdAt);

const STANDARD_SLOT_COUNT = 12;

const buildStats = await Promise.all(builds.map(async (build) => {
  const parts = await db.select().from(arBuildParts).where(eq(arBuildParts.buildId, build.id));
  const standard = parts.filter(p => p.slot !== 'extra');
  const acquired  = standard.filter(p => p.status === 'acquired').length;
  const totalCost = parts.reduce((s, p) => s + (p.price ?? 0), 0);
  return { id: build.id, filled: standard.length, acquired, totalCost };
}));

const statsMap = new Map(buildStats.map(s => [s.id, s]));

const STATUS_COLOR: Record<string, string> = {
  planning:    'var(--text-dim)',
  in_progress: 'var(--accent)',
  complete:    '#22c55e',
};
const STATUS_LABEL: Record<string, string> = {
  planning:    'Planning',
  in_progress: 'In Progress',
  complete:    'Complete',
};
const GAS_LABEL: Record<string, string> = {
  pistol:  'Pistol',
  carbine: 'Carbine',
  mid:     'Mid-length',
  rifle:   'Rifle-length',
};
---

<Layout title="AR Builds" sub={`${builds.length} build${builds.length !== 1 ? 's' : ''}`}>
  <slot name="actions" slot="actions">
    <a href="/builds/new" class="btn btn-primary">+ New Build</a>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:56rem">

    {builds.length === 0 && (
      <div class="empty-state">
        <div style="font-size:2rem;margin-bottom:0.5rem">🔧</div>
        <div style="font-weight:600;color:var(--text);margin-bottom:0.25rem">No builds yet</div>
        <div style="font-size:0.8rem;color:var(--text-dim);margin-bottom:1rem">Plan your next AR-15 build part by part.</div>
        <a href="/builds/new" class="btn btn-primary">+ New Build</a>
      </div>
    )}

    {builds.map(build => {
      const stats = statsMap.get(build.id)!;
      const pct   = Math.round((stats.acquired / STANDARD_SLOT_COUNT) * 100);
      return (
        <a href={`/builds/${build.id}`} style="text-decoration:none">
          <div class="card" style="padding:1.25rem;cursor:pointer;transition:border-color 0.15s" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor=''">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-wrap:wrap">
              <div>
                <div style="display:flex;align-items:center;gap:0.625rem;flex-wrap:wrap">
                  <span style="font-size:1rem;font-weight:700;color:var(--text)">{build.name}</span>
                  <span style={`font-size:0.65rem;font-weight:600;color:${STATUS_COLOR[build.status]};background:${STATUS_COLOR[build.status]}18;padding:0.15rem 0.5rem;border-radius:9999px`}>
                    {STATUS_LABEL[build.status]}
                  </span>
                </div>
                <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:0.375rem">
                  {build.caliber && <span class="pill pill-default">{build.caliber}</span>}
                  {build.gasSystem && <span class="pill pill-default">{GAS_LABEL[build.gasSystem] ?? build.gasSystem} gas</span>}
                  {build.barrelLength && <span class="pill pill-default">{build.barrelLength}" barrel</span>}
                </div>
                {build.description && (
                  <div style="font-size:0.75rem;color:var(--text-dim);margin-top:0.375rem">{build.description}</div>
                )}
              </div>
              <div style="text-align:right;flex-shrink:0">
                <div style="font-size:1.1rem;font-weight:700;color:var(--accent)">${stats.totalCost.toLocaleString('en-US', { maximumFractionDigits: 0 })}</div>
                {build.budget && (
                  <div style={`font-size:0.7rem;font-weight:600;${stats.totalCost > build.budget ? 'color:#f87171' : 'color:var(--text-dim)'}`}>
                    of ${build.budget.toLocaleString('en-US', { maximumFractionDigits: 0 })} budget
                  </div>
                )}
              </div>
            </div>

            <div style="margin-top:1rem">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.375rem">
                <span style="font-size:0.7rem;color:var(--text-dim)">{stats.acquired}/{STANDARD_SLOT_COUNT} parts acquired</span>
                <span style="font-size:0.7rem;font-weight:600;color:var(--accent)">{pct}%</span>
              </div>
              <div style="height:5px;background:var(--bg-card);border-radius:9999px;overflow:hidden">
                <div style={`height:100%;width:${pct}%;background:var(--accent);border-radius:9999px;transition:width 0.3s`}></div>
              </div>
              <div style="display:flex;gap:0.5rem;margin-top:0.5rem">
                {stats.filled > 0 && stats.acquired < stats.filled && (
                  <span style="font-size:0.65rem;color:var(--text-dim)">{stats.filled - stats.acquired} selected, {STANDARD_SLOT_COUNT - stats.filled} empty</span>
                )}
                {stats.filled === 0 && (
                  <span style="font-size:0.65rem;color:var(--text-dim)">No parts added yet</span>
                )}
              </div>
            </div>
          </div>
        </a>
      );
    })}

  </div>
</Layout>
