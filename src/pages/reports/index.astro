---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { sessionFirearms, ammoInventory, rangeSessions, ammoPurchases } from '../../db/schema';
import { eq, sql } from 'drizzle-orm';

// Monthly range spend: rounds_fired * cost_per_round, grouped by month
const spendRows = await db
  .select({
    month: sql<string>`strftime('%Y-%m', ${rangeSessions.date})`,
    spend: sql<number>`ROUND(SUM(${sessionFirearms.roundsFired} * COALESCE(${ammoInventory.costPerRound}, 0)), 2)`,
    rounds: sql<number>`SUM(${sessionFirearms.roundsFired})`,
  })
  .from(sessionFirearms)
  .leftJoin(rangeSessions, eq(sessionFirearms.sessionId, rangeSessions.id))
  .leftJoin(ammoInventory, eq(sessionFirearms.ammoId, ammoInventory.id))
  .groupBy(sql`strftime('%Y-%m', ${rangeSessions.date})`)
  .orderBy(sql`strftime('%Y-%m', ${rangeSessions.date})`);

// Monthly ammo purchases: sum of total_cost grouped by month
const purchaseRows = await db
  .select({
    month: sql<string>`strftime('%Y-%m', ${ammoPurchases.date})`,
    spend: sql<number>`ROUND(SUM(${ammoPurchases.totalCost}), 2)`,
    rounds: sql<number>`SUM(${ammoPurchases.quantity})`,
  })
  .from(ammoPurchases)
  .groupBy(sql`strftime('%Y-%m', ${ammoPurchases.date})`)
  .orderBy(sql`strftime('%Y-%m', ${ammoPurchases.date})`);

// Caliber spend breakdown (all time)
const caliberRows = await db
  .select({
    caliber: ammoInventory.caliber,
    spend: sql<number>`ROUND(SUM(${sessionFirearms.roundsFired} * COALESCE(${ammoInventory.costPerRound}, 0)), 2)`,
    rounds: sql<number>`SUM(${sessionFirearms.roundsFired})`,
  })
  .from(sessionFirearms)
  .leftJoin(ammoInventory, eq(sessionFirearms.ammoId, ammoInventory.id))
  .groupBy(ammoInventory.caliber)
  .orderBy(sql`SUM(${sessionFirearms.roundsFired} * COALESCE(${ammoInventory.costPerRound}, 0)) DESC`);

const totalRangeSpend = spendRows.reduce((s, r) => s + (r.spend ?? 0), 0);
const totalPurchaseSpend = purchaseRows.reduce((s, r) => s + (r.spend ?? 0), 0);

function formatMonth(m: string) {
  const [y, mo] = m.split('-');
  return new Date(parseInt(y), parseInt(mo) - 1).toLocaleDateString('en-US', { month: 'short', year: '2-digit' });
}
---

<Layout title="Reports" sub="Spend & usage over time">
  <div style="display:flex;flex-direction:column;gap:1.75rem;max-width:56rem">

    {spendRows.length === 0 && purchaseRows.length === 0 && (
      <div class="empty-state">
        <div class="empty-state-icon">📊</div>
        <div class="empty-state-text">Log sessions with ammo linked, or record ammo purchases, to see spend reports.</div>
      </div>
    )}

    <!-- Summary stats -->
    {(totalRangeSpend > 0 || totalPurchaseSpend > 0) && (
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem">
        {totalRangeSpend > 0 && (
          <div class="stat-card">
            <div>
              <div class="stat-card-label">Total Range Spend</div>
              <div class="stat-card-value" style="color:#f59e0b">${totalRangeSpend.toFixed(2)}</div>
              <div class="stat-card-sub">ammo at range, all time</div>
            </div>
          </div>
        )}
        {totalPurchaseSpend > 0 && (
          <div class="stat-card">
            <div>
              <div class="stat-card-label">Total Ammo Purchased</div>
              <div class="stat-card-value" style="color:#22c55e">${totalPurchaseSpend.toFixed(2)}</div>
              <div class="stat-card-sub">all purchase logs</div>
            </div>
          </div>
        )}
        {totalRangeSpend > 0 && totalPurchaseSpend > 0 && (
          <div class="stat-card">
            <div>
              <div class="stat-card-label">Net Position</div>
              <div class="stat-card-value" style={`color:${totalPurchaseSpend - totalRangeSpend >= 0 ? '#22c55e' : '#f87171'}`}>
                ${(totalPurchaseSpend - totalRangeSpend).toFixed(2)}
              </div>
              <div class="stat-card-sub">purchased − shot</div>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Monthly range spend chart -->
    {spendRows.filter(r => r.spend > 0).length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">▲</span>
          <span class="section-title">Monthly Range Spend</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">rounds fired × cost/rd</span>
        </div>
        <div class="card" style="padding:1.25rem">
          <canvas
            id="spend-chart"
            data-bars={JSON.stringify(spendRows.map(r => ({ label: formatMonth(r.month), value: r.spend ?? 0, sub: `${(r.rounds ?? 0).toLocaleString()} rds` })))}
            style="width:100%;height:180px"
            height="180"
          ></canvas>
        </div>
      </div>
    )}

    <!-- Monthly purchase chart -->
    {purchaseRows.filter(r => r.spend > 0).length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:#22c55e;font-size:0.75rem">▲</span>
          <span class="section-title">Monthly Ammo Purchases</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">total cost logged</span>
        </div>
        <div class="card" style="padding:1.25rem">
          <canvas
            id="purchase-chart"
            data-bars={JSON.stringify(purchaseRows.map(r => ({ label: formatMonth(r.month), value: r.spend ?? 0, sub: `${(r.rounds ?? 0).toLocaleString()} rds` })))}
            data-color="#22c55e"
            style="width:100%;height:180px"
            height="180"
          ></canvas>
        </div>
      </div>
    )}

    <!-- Caliber breakdown -->
    {caliberRows.filter(r => r.spend > 0).length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">◉</span>
          <span class="section-title">Range Spend by Caliber</span>
        </div>
        <div class="card card-divide">
          {caliberRows.filter(r => r.spend > 0).map(r => {
            const pct = totalRangeSpend > 0 ? (r.spend / totalRangeSpend) * 100 : 0;
            return (
              <div class="list-row" style="flex-direction:column;gap:0.375rem;align-items:stretch">
                <div style="display:flex;justify-content:space-between;align-items:center">
                  <span style="font-size:0.875rem;font-weight:600;color:var(--text)">{r.caliber ?? 'Unknown'}</span>
                  <div style="display:flex;align-items:center;gap:1rem">
                    <span style="font-size:0.75rem;color:var(--text-muted)">{(r.rounds ?? 0).toLocaleString()} rds</span>
                    <span style="font-size:0.875rem;font-weight:700;color:#f59e0b">${(r.spend ?? 0).toFixed(2)}</span>
                  </div>
                </div>
                <div style="height:4px;background:var(--bg-hover);border-radius:9999px;overflow:hidden">
                  <div style={`height:100%;width:${pct.toFixed(1)}%;background:var(--accent);border-radius:9999px;transition:width 0.3s`}></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const style = getComputedStyle(document.documentElement);
    const border = style.getPropertyValue('--border').trim() || '#1e2433';
    const defaultAccent = style.getPropertyValue('--accent').trim() || '#06b6d4';

    document.querySelectorAll<HTMLCanvasElement>('canvas[data-bars]').forEach(canvas => {
      const bars: { label: string; value: number; sub: string }[] = JSON.parse(canvas.dataset.bars!);
      const accent = canvas.dataset.color || defaultAccent;
      if (!bars.length) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const w = canvas.offsetWidth || 500;
      const h = canvas.offsetHeight || 180;
      canvas.width = w * devicePixelRatio;
      canvas.height = h * devicePixelRatio;
      ctx.scale(devicePixelRatio, devicePixelRatio);

      const pad = { top: 20, right: 10, bottom: 40, left: 52 };
      const chartW = w - pad.left - pad.right;
      const chartH = h - pad.top - pad.bottom;

      const maxVal = Math.max(...bars.map(b => b.value), 0.01);
      const barW = Math.max(8, (chartW / bars.length) * 0.6);
      const gap = chartW / bars.length;

      // Grid lines
      ctx.strokeStyle = border;
      ctx.lineWidth = 1;
      [0, 0.5, 1].forEach(t => {
        const y = pad.top + t * chartH;
        ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + chartW, y); ctx.stroke();
        ctx.fillStyle = '#6b7280';
        ctx.font = '10px ui-monospace,monospace';
        ctx.textAlign = 'right';
        ctx.fillText(`$${(maxVal * (1 - t)).toFixed(0)}`, pad.left - 4, y + 3.5);
      });

      bars.forEach((bar, i) => {
        const x = pad.left + gap * i + gap / 2 - barW / 2;
        const barH = (bar.value / maxVal) * chartH;
        const y = pad.top + chartH - barH;

        // Bar
        ctx.fillStyle = accent + 'cc';
        ctx.beginPath();
        ctx.roundRect(x, y, barW, barH, [3, 3, 0, 0]);
        ctx.fill();

        // Value label on top of bar
        if (bar.value > 0) {
          ctx.fillStyle = accent;
          ctx.font = `bold 9px ui-sans-serif,sans-serif`;
          ctx.textAlign = 'center';
          ctx.fillText(`$${bar.value.toFixed(0)}`, x + barW / 2, y - 4);
        }

        // X-axis label
        ctx.fillStyle = '#6b7280';
        ctx.font = '9px ui-sans-serif,sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(bar.label, x + barW / 2, h - pad.bottom + 14);

        // Sub label (rounds)
        if (bars.length <= 12) {
          ctx.fillStyle = '#4b5563';
          ctx.font = '8px ui-sans-serif,sans-serif';
          ctx.fillText(bar.sub, x + barW / 2, h - pad.bottom + 24);
        }
      });
    });
  });
</script>
