---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { firearms } from '../../db/schema';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const [inserted] = await db.insert(firearms).values({
    name:          form.get('name') as string,
    make:          form.get('make') as string,
    model:         form.get('model') as string,
    caliber:       form.get('caliber') as string,
    serial:        form.get('serial') as string || null,
    generation:    form.get('generation') as string || null,
    type:          form.get('type') as string,
    purchaseDate:  form.get('purchaseDate') as string || null,
    purchasePrice: form.get('purchasePrice') ? parseFloat(form.get('purchasePrice') as string) : null,
    notes:         form.get('notes') as string || null,
  }).returning({ id: firearms.id });
  return Astro.redirect(`/firearms/${inserted.id}`);
}
---

<Layout title="Add Firearm" backHref="/firearms">
  <form method="POST" class="form-section" style="max-width:36rem">

    <div><label>Nickname / Name *</label><input name="name" type="text" required placeholder="e.g. Duty Glock" /></div>

    <div class="form-row form-row-2">
      <div><label>Make *</label><input name="make" type="text" required placeholder="Glock" /></div>
      <div><label>Model *</label><input name="model" type="text" required placeholder="19" /></div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Caliber *</label><input name="caliber" type="text" required placeholder="9mm" /></div>
      <div>
        <label>Type *</label>
        <select name="type" required>
          <option value="pistol">Pistol</option>
          <option value="rifle">Rifle</option>
          <option value="shotgun">Shotgun</option>
          <option value="revolver">Revolver</option>
          <option value="nfa">NFA Item</option>
          <option value="other">Other</option>
        </select>
      </div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Serial Number</label><input name="serial" type="text" placeholder="Optional" /></div>
      <div><label>Generation</label><input name="generation" type="text" placeholder="e.g. Gen 5" /></div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Purchase Date</label><input name="purchaseDate" type="date" /></div>
      <div><label>Purchase Price ($)</label><input name="purchasePrice" type="number" step="0.01" min="0" placeholder="0.00" /></div>
    </div>

    <div><label>Notes</label><textarea name="notes" rows="3" placeholder="Modifications, history, etc."></textarea></div>

    <button type="submit" class="btn btn-primary btn-full">Save Firearm</button>
  </form>
</Layout>
