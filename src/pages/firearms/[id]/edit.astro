---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../db';
import { firearms } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/firearms');

const [firearm] = await db.select().from(firearms).where(eq(firearms.id, id));
if (!firearm) return Astro.redirect('/firearms');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  await db.update(firearms).set({
    name: form.get('name') as string,
    make: form.get('make') as string,
    model: form.get('model') as string,
    caliber: form.get('caliber') as string,
    serial: form.get('serial') as string || null,
    generation: form.get('generation') as string || null,
    type: form.get('type') as string,
    purchaseDate: form.get('purchaseDate') as string || null,
    purchasePrice: form.get('purchasePrice') ? parseFloat(form.get('purchasePrice') as string) : null,
    notes: form.get('notes') as string || null,
  }).where(eq(firearms.id, id));
  return Astro.redirect(`/firearms/${id}`);
}
---

<Layout title={`Edit — ${firearm.name}`} backHref={`/firearms/${id}`} backLabel={firearm.name}>
  <form method="POST" class="px-4 py-5 space-y-4">

    <div>
      <label for="name">Nickname / Name *</label>
      <input id="name" name="name" type="text" required value={firearm.name} />
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="make">Make *</label>
        <input id="make" name="make" type="text" required value={firearm.make} />
      </div>
      <div>
        <label for="model">Model *</label>
        <input id="model" name="model" type="text" required value={firearm.model} />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="caliber">Caliber *</label>
        <input id="caliber" name="caliber" type="text" required value={firearm.caliber} />
      </div>
      <div>
        <label for="type">Type *</label>
        <select id="type" name="type" required>
          {['pistol','rifle','shotgun','revolver','other'].map(t => (
            <option value={t} selected={firearm.type === t}>{t.charAt(0).toUpperCase() + t.slice(1)}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="serial">Serial Number</label>
        <input id="serial" name="serial" type="text" value={firearm.serial ?? ''} />
      </div>
      <div>
        <label for="generation">Generation</label>
        <input id="generation" name="generation" type="text" value={firearm.generation ?? ''} placeholder="e.g. Gen 5" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label for="purchaseDate">Purchase Date</label>
        <input id="purchaseDate" name="purchaseDate" type="date" value={firearm.purchaseDate ?? ''} />
      </div>
      <div>
        <label for="purchasePrice">Purchase Price ($)</label>
        <input id="purchasePrice" name="purchasePrice" type="number" step="0.01" min="0"
          value={firearm.purchasePrice ?? ''} />
      </div>
    </div>

    <div>
      <label for="notes">Notes</label>
      <textarea id="notes" name="notes" rows="4">{firearm.notes ?? ''}</textarea>
    </div>

    <button type="submit" class="btn-primary w-full">Save Changes</button>
  </form>
</Layout>
