---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../db';
import { firearms } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/firearms');

const [firearm] = await db.select().from(firearms).where(eq(firearms.id, id));
if (!firearm) return Astro.redirect('/firearms');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  await db.update(firearms).set({
    name:          form.get('name') as string,
    make:          form.get('make') as string,
    model:         form.get('model') as string,
    caliber:       form.get('caliber') as string,
    serial:        form.get('serial') as string || null,
    generation:    form.get('generation') as string || null,
    type:          form.get('type') as string,
    purchaseDate:  form.get('purchaseDate') as string || null,
    purchasePrice:         form.get('purchasePrice') ? parseFloat(form.get('purchasePrice') as string) : null,
    notes:                 form.get('notes') as string || null,
    serviceIntervalRounds: form.get('serviceIntervalRounds') ? parseInt(form.get('serviceIntervalRounds') as string) : null,
  }).where(eq(firearms.id, id));
  return Astro.redirect(`/firearms/${id}`);
}
---

<Layout title={`Edit — ${firearm.name}`} backHref={`/firearms/${id}`}>
  <form method="POST" class="form-section" style="max-width:36rem">

    <div><label>Nickname / Name *</label><input name="name" type="text" required value={firearm.name} /></div>

    <div class="form-row form-row-2">
      <div><label>Make *</label><input name="make" type="text" required value={firearm.make} /></div>
      <div><label>Model *</label><input name="model" type="text" required value={firearm.model} /></div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Caliber *</label><input name="caliber" type="text" required value={firearm.caliber} /></div>
      <div>
        <label>Type *</label>
        <select name="type" required>
          {['pistol','rifle','shotgun','revolver','other'].map(t => (
            <option value={t} selected={firearm.type === t}>{t.charAt(0).toUpperCase() + t.slice(1)}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Serial Number</label><input name="serial" type="text" value={firearm.serial ?? ''} /></div>
      <div><label>Generation</label><input name="generation" type="text" value={firearm.generation ?? ''} placeholder="e.g. Gen 5" /></div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Purchase Date</label><input name="purchaseDate" type="date" value={firearm.purchaseDate ?? ''} /></div>
      <div><label>Purchase Price ($)</label><input name="purchasePrice" type="number" step="0.01" min="0" value={firearm.purchasePrice ?? ''} /></div>
    </div>

    <div><label>Notes</label><textarea name="notes" rows="4">{firearm.notes ?? ''}</textarea></div>

    <div><label>Service Interval (rounds)</label><input name="serviceIntervalRounds" type="number" min="1" value={firearm.serviceIntervalRounds ?? ''} placeholder="e.g. 500 — dashboard alerts when due" /></div>

    <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
  </form>
</Layout>
