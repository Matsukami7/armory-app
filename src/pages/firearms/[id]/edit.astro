---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../db';
import { firearms } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/firearms');

const [firearm] = await db.select().from(firearms).where(eq(firearms.id, id));
if (!firearm) return Astro.redirect('/firearms');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  await db.update(firearms).set({
    name:          form.get('name') as string,
    make:          form.get('make') as string,
    model:         form.get('model') as string,
    caliber:       form.get('caliber') as string,
    serial:        form.get('serial') as string || null,
    generation:    form.get('generation') as string || null,
    type:          form.get('type') as string,
    purchaseDate:  form.get('purchaseDate') as string || null,
    purchasePrice:         form.get('purchasePrice') ? parseFloat(form.get('purchasePrice') as string) : null,
    notes:                 form.get('notes') as string || null,
    currentValue:          form.get('currentValue') ? parseFloat(form.get('currentValue') as string) : null,
    serviceIntervalRounds: form.get('serviceIntervalRounds') ? parseInt(form.get('serviceIntervalRounds') as string) : null,
    cleanIntervalDays:     form.get('cleanIntervalDays') ? parseInt(form.get('cleanIntervalDays') as string) : null,
    barrelRoundCount:      form.get('barrelRoundCount') ? parseInt(form.get('barrelRoundCount') as string) : 0,
    barrelRatedRounds:     form.get('barrelRatedRounds') ? parseInt(form.get('barrelRatedRounds') as string) : null,
  }).where(eq(firearms.id, id));
  return Astro.redirect(`/firearms/${id}`);
}
---

<Layout title={`Edit — ${firearm.name}`} backHref={`/firearms/${id}`}>
  <form method="POST" class="form-section" style="max-width:36rem">

    <div><label>Nickname / Name *</label><input name="name" type="text" required value={firearm.name} /></div>

    <div class="form-row form-row-2">
      <div><label>Make *</label><input name="make" type="text" required value={firearm.make} /></div>
      <div><label>Model *</label><input name="model" type="text" required value={firearm.model} /></div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Caliber *</label><input name="caliber" type="text" required value={firearm.caliber} /></div>
      <div>
        <label>Type *</label>
        <select name="type" required>
          {[
            ['pistol', 'Pistol'], ['rifle', 'Rifle'], ['shotgun', 'Shotgun'],
            ['revolver', 'Revolver'], ['nfa', 'NFA Item'], ['other', 'Other'],
          ].map(([t, label]) => (
            <option value={t} selected={firearm.type === t}>{label}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Serial Number</label><input name="serial" type="text" value={firearm.serial ?? ''} /></div>
      <div><label>Generation</label><input name="generation" type="text" value={firearm.generation ?? ''} placeholder="e.g. Gen 5" /></div>
    </div>

    <div class="form-row form-row-2">
      <div><label>Purchase Date</label><input name="purchaseDate" type="date" value={firearm.purchaseDate ?? ''} /></div>
      <div><label>Purchase Price ($)</label><input name="purchasePrice" type="number" step="0.01" min="0" value={firearm.purchasePrice ?? ''} /></div>
    </div>

    <div><label>Estimated Current Value ($)</label><input name="currentValue" type="number" step="0.01" min="0" value={firearm.currentValue ?? ''} placeholder="Leave blank to use purchase price" /></div>

    <div><label>Notes</label><textarea name="notes" rows="4">{firearm.notes ?? ''}</textarea></div>

    <div class="form-row form-row-2">
      <div><label>Cleaning Interval (rounds)</label><input name="serviceIntervalRounds" type="number" min="1" value={firearm.serviceIntervalRounds ?? ''} placeholder="e.g. 500" /></div>
      <div><label>Cleaning Interval (days)</label><input name="cleanIntervalDays" type="number" min="1" value={firearm.cleanIntervalDays ?? ''} placeholder="e.g. 90" /></div>
    </div>
    <p style="font-size:0.72rem;color:var(--text-muted);margin-top:-0.5rem">Either threshold triggers a cleaning alert — whichever comes first.</p>

    <div class="form-row form-row-2">
      <div><label>Barrel Round Count</label><input name="barrelRoundCount" type="number" min="0" value={firearm.barrelRoundCount ?? 0} placeholder="0" /></div>
      <div><label>Barrel Rated Rounds</label><input name="barrelRatedRounds" type="number" min="1" value={firearm.barrelRatedRounds ?? ''} placeholder="e.g. 20000 — optional" /></div>
    </div>
    <p style="font-size:0.72rem;color:var(--text-muted);margin-top:-0.5rem">Barrel round count is separate from firearm lifetime rounds. Set rated rounds to get an alert when approaching end of life.</p>

    <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
  </form>
</Layout>
