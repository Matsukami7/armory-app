---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { firearms, firearmPhotos, accessories, maintenanceLogs, sessionFirearms } from '../../db/schema';
import { eq, sum, desc } from 'drizzle-orm';
import { saveUpload } from '../../lib/uploads';
import { parseTags, serializeTags, tagColor } from '../../lib/tags';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/firearms');

const [firearm] = await db.select().from(firearms).where(eq(firearms.id, id));
if (!firearm) return Astro.redirect('/firearms');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    await db.delete(firearms).where(eq(firearms.id, id));
    return Astro.redirect('/firearms');
  }
  if (action === 'upload_photo') {
    const file = form.get('photo') as File | null;
    if (file && file.size > 0) {
      const photoPath = await saveUpload(file, 'firearms');
      if (photoPath) await db.update(firearms).set({ photoPath }).where(eq(firearms.id, id));
    }
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'add_gallery_photo') {
    const file = form.get('photo') as File | null;
    if (file && file.size > 0) {
      const path = await saveUpload(file, 'firearms');
      if (path) await db.insert(firearmPhotos).values({ firearmId: id, path, caption: form.get('caption') as string || null });
    }
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'delete_gallery_photo') {
    await db.delete(firearmPhotos).where(eq(firearmPhotos.id, parseInt(form.get('photoId') as string)));
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'set_primary_photo') {
    const path = form.get('path') as string;
    const photoId = parseInt(form.get('photoId') as string);
    await db.update(firearms).set({ photoPath: path }).where(eq(firearms.id, id));
    await db.delete(firearmPhotos).where(eq(firearmPhotos.id, photoId));
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'add_maintenance') {
    await db.insert(maintenanceLogs).values({
      firearmId:  id,
      date:       form.get('date') as string,
      type:       form.get('type') as string,
      notes:      form.get('notes') as string,
      roundCount: form.get('roundCount') ? parseInt(form.get('roundCount') as string) : null,
    });
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'delete_log') {
    await db.delete(maintenanceLogs).where(eq(maintenanceLogs.id, parseInt(form.get('logId') as string)));
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'add_accessory') {
    const accType = form.get('type') as string;
    await db.insert(accessories).values({
      firearmId:     id,
      name:          form.get('name') as string,
      type:          accType,
      make:          form.get('make') as string || null,
      model:         form.get('model') as string || null,
      notes:         form.get('notes') as string || null,
      purchasePrice: form.get('purchasePrice') ? parseFloat(form.get('purchasePrice') as string) : null,
      lumens:        accType === 'light' && form.get('lumens') ? parseInt(form.get('lumens') as string) : null,
      powerType:     accType === 'light' ? form.get('powerType') as string || null : null,
      batteryType:   accType === 'light' && form.get('powerType') === 'battery' ? form.get('batteryType') as string || null : null,
      zeroData:      accType === 'optic' ? form.get('zeroData') as string || null : null,
    });
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'upload_accessory_photo') {
    const accId = parseInt(form.get('accId') as string);
    const file = form.get('photo') as File | null;
    if (file && file.size > 0) {
      const path = await saveUpload(file, 'accessories');
      if (path) await db.update(accessories).set({ photoPath: path }).where(eq(accessories.id, accId));
    }
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'update_accessory_notes') {
    const accId = parseInt(form.get('accId') as string);
    await db.update(accessories).set({
      zeroData:           form.get('zeroData') as string || null,
      batteryChangedDate: form.get('batteryChangedDate') as string || null,
      notes:              form.get('notes') as string || null,
    }).where(eq(accessories.id, accId));
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'delete_accessory') {
    await db.delete(accessories).where(eq(accessories.id, parseInt(form.get('accId') as string)));
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'add_tag') {
    const tag = (form.get('tag') as string ?? '').trim().toLowerCase().replace(/[^a-z0-9-]/g, '');
    if (tag) {
      const [cur] = await db.select({ tags: firearms.tags }).from(firearms).where(eq(firearms.id, id));
      const existing = parseTags(cur?.tags ?? null);
      if (!existing.includes(tag)) {
        await db.update(firearms).set({ tags: serializeTags([...existing, tag]) }).where(eq(firearms.id, id));
      }
    }
    return Astro.redirect(`/firearms/${id}`);
  }
  if (action === 'remove_tag') {
    const tag = form.get('tag') as string;
    const [cur] = await db.select({ tags: firearms.tags }).from(firearms).where(eq(firearms.id, id));
    const updated = parseTags(cur?.tags ?? null).filter(t => t !== tag);
    await db.update(firearms).set({ tags: serializeTags(updated) }).where(eq(firearms.id, id));
    return Astro.redirect(`/firearms/${id}`);
  }
}

const [gun]      = await db.select().from(firearms).where(eq(firearms.id, id));
const gallery    = await db.select().from(firearmPhotos).where(eq(firearmPhotos.firearmId, id)).orderBy(desc(firearmPhotos.createdAt));
const accs       = await db.select().from(accessories).where(eq(accessories.firearmId, id));
const logs       = await db.select().from(maintenanceLogs).where(eq(maintenanceLogs.firearmId, id)).orderBy(desc(maintenanceLogs.date));
const [rRow]     = await db.select({ total: sum(sessionFirearms.roundsFired) }).from(sessionFirearms).where(eq(sessionFirearms.firearmId, id));
const totalRounds = Number(rRow?.total ?? 0);

const gunTags = parseTags(gun.tags);
const typeLabel: Record<string, string> = { pistol:'Pistol', rifle:'Rifle', shotgun:'Shotgun', revolver:'Revolver', other:'Other' };
const logIcon:   Record<string, string> = { cleaning:'🧹', repair:'🔧', inspection:'🔍', modification:'⚙️', note:'📝' };
---

<Layout title={gun.name} sub={`${gun.make} ${gun.model}${gun.generation ? ` ${gun.generation}` : ''} · ${gun.caliber}`} backHref="/firearms">
  <slot name="actions" slot="actions">
    <a href={`/firearms/${id}/edit`} class="btn btn-secondary">Edit</a>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:52rem">

    <!-- Photo + overview -->
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">

      <!-- Primary photo -->
      <div class="card" style="overflow:hidden;position:relative">
        {gun.photoPath
          ? <img src={gun.photoPath} alt={gun.name} style="width:100%;height:14rem;object-fit:cover;display:block" />
          : <div style="height:14rem;display:flex;align-items:center;justify-content:center;color:var(--text-dim)">
              <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
              </svg>
            </div>
        }
        <form method="POST" enctype="multipart/form-data" style="position:absolute;bottom:0.625rem;right:0.625rem">
          <input type="hidden" name="_action" value="upload_photo" />
          <label class="btn btn-secondary btn-sm" style="cursor:pointer">
            {gun.photoPath ? 'Change' : '+ Photo'}
            <input type="file" name="photo" accept="image/*" style="display:none" onchange="this.form.submit()" />
          </label>
        </form>
      </div>

      <!-- Stats -->
      <div style="display:flex;flex-direction:column;gap:0.75rem">
        <div class="stat-card" style="flex:1">
          <div>
            <div class="stat-card-label">Rounds Fired</div>
            <div class="stat-card-value" style="color:#f97316">{totalRounds.toLocaleString()}</div>
            <div class="stat-card-sub">lifetime total</div>
          </div>
        </div>
        {(gun.purchasePrice || gun.currentValue) && (
          <div class="stat-card" style="flex:1">
            <div>
              {gun.currentValue && (
                <>
                  <div class="stat-card-label">Est. Value</div>
                  <div class="stat-card-value" style="color:#22c55e">${gun.currentValue.toFixed(2)}</div>
                  {gun.purchasePrice && <div class="stat-card-sub">paid ${gun.purchasePrice.toFixed(2)}</div>}
                </>
              )}
              {!gun.currentValue && gun.purchasePrice && (
                <>
                  <div class="stat-card-label">Purchase Price</div>
                  <div class="stat-card-value" style="color:#22c55e">${gun.purchasePrice.toFixed(2)}</div>
                  {gun.purchaseDate && <div class="stat-card-sub">{gun.purchaseDate}</div>}
                </>
              )}
            </div>
          </div>
        )}
        {gun.serial && (
          <div class="card" style="padding:1rem">
            <div style="font-size:0.6rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.25rem">Serial</div>
            <div style="font-family:ui-monospace,monospace;font-size:0.875rem;color:var(--text)">{gun.serial}</div>
          </div>
        )}
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
          <span class="pill pill-accent">{typeLabel[gun.type] ?? gun.type}</span>
          <span class="pill pill-default">{gun.caliber}</span>
          {gun.generation && <span class="pill pill-default">{gun.generation}</span>}
        </div>

        <!-- Tags -->
        <div style="display:flex;flex-wrap:wrap;gap:0.375rem;align-items:center">
          {gunTags.map(tag => (
            <span style={`display:inline-flex;align-items:center;gap:0.25rem;font-size:0.65rem;font-weight:700;letter-spacing:0.06em;background:${tagColor(tag)}22;color:${tagColor(tag)};border:1px solid ${tagColor(tag)}44;padding:0.2rem 0.45rem;border-radius:9999px`}>
              #{tag}
              <form method="POST" style="display:contents">
                <input type="hidden" name="_action" value="remove_tag" />
                <input type="hidden" name="tag" value={tag} />
                <button type="submit" style="background:none;border:none;cursor:pointer;color:inherit;padding:0;line-height:1;font-size:0.7rem;opacity:0.7">✕</button>
              </form>
            </span>
          ))}
          <form method="POST" style="display:flex;gap:0.25rem;align-items:center">
            <input type="hidden" name="_action" value="add_tag" />
            <input name="tag" type="text" placeholder="+ tag" style="font-size:0.65rem;width:4.5rem;padding:0.2rem 0.4rem;border-radius:9999px;border:1px solid var(--border);background:var(--bg-hover);color:var(--text)" />
          </form>
        </div>
      </div>

    </div>

    <!-- Photo gallery -->
    {(gallery.length > 0 || true) && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">◻</span>
          <span class="section-title">Photo Gallery</span>
        </div>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:flex-start">
          {gallery.map(p => (
            <div style="position:relative;flex-shrink:0">
              <a href={p.path} target="_blank">
                <img src={p.path} alt={p.caption ?? ''} style="width:8rem;height:6rem;object-fit:cover;border-radius:0.375rem;border:1px solid var(--border);display:block" />
              </a>
              <div style="display:flex;gap:0.25rem;margin-top:0.25rem">
                <form method="POST" style="flex:1">
                  <input type="hidden" name="_action" value="set_primary_photo" />
                  <input type="hidden" name="photoId" value={p.id} />
                  <input type="hidden" name="path" value={p.path} />
                  <button type="submit" class="btn btn-secondary btn-sm" style="width:100%;font-size:0.65rem;padding:0.2rem 0.4rem" title="Set as cover photo">Cover</button>
                </form>
                <form method="POST">
                  <input type="hidden" name="_action" value="delete_gallery_photo" />
                  <input type="hidden" name="photoId" value={p.id} />
                  <button type="submit" class="btn-delete" title="Delete photo">✕</button>
                </form>
              </div>
            </div>
          ))}
          <!-- Upload new gallery photo -->
          <form method="POST" enctype="multipart/form-data" style="flex-shrink:0">
            <input type="hidden" name="_action" value="add_gallery_photo" />
            <label style="display:flex;flex-direction:column;align-items:center;justify-content:center;width:8rem;height:6rem;border:1px dashed var(--border);border-radius:0.375rem;cursor:pointer;color:var(--text-dim);font-size:0.75rem;gap:0.25rem;transition:border-color 0.15s" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              Add Photo
              <input type="file" name="photo" accept="image/*" style="display:none" onchange="this.form.submit()" />
            </label>
          </form>
        </div>
      </div>
    )}

    {gun.notes && (
      <div class="card" style="padding:1.25rem">
        <div style="font-size:0.6rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.5rem">Notes</div>
        <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6">{gun.notes}</p>
      </div>
    )}

    <!-- Accessories -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">◈</span>
        <span class="section-title">Accessories</span>
      </div>
      {accs.length > 0 && (
        <div class="card card-divide" style="margin-bottom:0.75rem">
          {accs.map(a => (
            <div style="padding:0.875rem 1rem">
              <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.75rem">
                <div style="flex:1;min-width:0">
                  <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                    <span style="font-size:0.875rem;font-weight:600;color:var(--text)">{a.name}</span>
                    {a.type === 'light' && a.lumens && <span class="pill pill-accent">{a.lumens} lm</span>}
                  </div>
                  <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.125rem">
                    {a.type}{a.make ? ` · ${a.make} ${a.model ?? ''}` : ''}
                    {a.purchasePrice ? ` · $${a.purchasePrice.toFixed(2)}` : ''}
                  </div>
                  {a.type === 'light' && a.powerType && (
                    <div style="display:flex;align-items:center;gap:0.375rem;margin-top:0.25rem;flex-wrap:wrap">
                      <span style="font-size:0.7rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--text-dim)">
                        {a.powerType === 'rechargeable' ? '⚡ Rechargeable' : '🔋 Battery'}
                      </span>
                      {a.powerType === 'battery' && a.batteryType && <span class="pill pill-default" style="font-size:0.65rem">{a.batteryType}</span>}
                      {a.batteryChangedDate && <span style="font-size:0.7rem;color:var(--text-dim)">changed {a.batteryChangedDate}</span>}
                    </div>
                  )}
                  {a.zeroData && <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.25rem">🎯 {a.zeroData}</div>}
                  {a.notes && <div style="font-size:0.75rem;color:var(--text-dim);margin-top:0.125rem">{a.notes}</div>}
                </div>
                <div style="display:flex;flex-direction:column;gap:0.375rem;align-items:flex-end;flex-shrink:0">
                  {a.photoPath && <a href={a.photoPath} target="_blank"><img src={a.photoPath} alt={a.name} style="width:5rem;height:3.5rem;object-fit:cover;border-radius:0.25rem;border:1px solid var(--border)" /></a>}
                  <div style="display:flex;gap:0.375rem;align-items:center">
                    <form method="POST" enctype="multipart/form-data">
                      <input type="hidden" name="_action" value="upload_accessory_photo" />
                      <input type="hidden" name="accId" value={a.id} />
                      <label class="btn btn-secondary btn-sm" style="cursor:pointer;font-size:0.65rem">
                        {a.photoPath ? '📷' : '+ Photo'}
                        <input type="file" name="photo" accept="image/*" style="display:none" onchange="this.form.submit()" />
                      </label>
                    </form>
                    <form method="POST">
                      <input type="hidden" name="_action" value="delete_accessory" />
                      <input type="hidden" name="accId" value={a.id} />
                      <button type="submit" class="btn-delete">✕</button>
                    </form>
                  </div>
                </div>
              </div>
              <details style="margin-top:0.5rem">
                <summary style="font-size:0.65rem;color:var(--text-dim);cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:0.25rem">▸ Edit notes</summary>
                <form method="POST" class="form-section" style="margin-top:0.5rem;padding-top:0.5rem;border-top:1px solid var(--border)">
                  <input type="hidden" name="_action" value="update_accessory_notes" />
                  <input type="hidden" name="accId" value={a.id} />
                  {a.type === 'optic' && <div><label>Zero Data</label><input name="zeroData" type="text" value={a.zeroData ?? ''} placeholder="e.g. 50yd zero, 12 clicks up" /></div>}
                  {a.type === 'light' && <div><label>Battery Changed</label><input name="batteryChangedDate" type="date" value={a.batteryChangedDate ?? ''} /></div>}
                  <div><label>Notes</label><input name="notes" type="text" value={a.notes ?? ''} /></div>
                  <button type="submit" class="btn btn-secondary btn-sm">Save</button>
                </form>
              </details>
            </div>
          ))}
        </div>
      )}
      <details class="accordion">
        <summary>+ Add Accessory</summary>
        <form method="POST" class="form-section" id="acc-form">
          <input type="hidden" name="_action" value="add_accessory" />
          <div><label>Name *</label><input name="name" type="text" required placeholder="Trijicon RMR" /></div>
          <div class="form-row form-row-2">
            <div>
              <label>Type</label>
              <select name="type" id="acc-type" onchange="updateAccForm()">
                <option value="optic">Optic</option>
                <option value="light">Light</option>
                <option value="suppressor">Suppressor</option>
                <option value="grip">Grip</option>
                <option value="stock">Stock</option>
                <option value="trigger">Trigger</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div><label>Price ($)</label><input name="purchasePrice" type="number" step="0.01" min="0" /></div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Make</label><input name="make" type="text" /></div>
            <div><label>Model</label><input name="model" type="text" /></div>
          </div>
          <div id="light-fields" style="display:none;border-top:1px solid var(--border);padding-top:0.75rem;margin-top:0.25rem">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);margin-bottom:0.75rem">Light Details</div>
            <div class="form-row form-row-2">
              <div><label>Lumens</label><input name="lumens" type="number" min="1" placeholder="e.g. 1000" /></div>
              <div>
                <label>Power Source</label>
                <select name="powerType" id="acc-power" onchange="updateAccForm()">
                  <option value="">Select...</option>
                  <option value="rechargeable">Rechargeable</option>
                  <option value="battery">Battery Powered</option>
                </select>
              </div>
            </div>
            <div id="battery-fields" style="display:none">
              <label>Battery Type</label>
              <select name="batteryType">
                <option value="">Select...</option>
                <option value="CR123A">CR123A</option>
                <option value="18650">18650</option>
                <option value="AA">AA</option>
                <option value="AAA">AAA</option>
                <option value="CR2">CR2</option>
                <option value="16340">16340</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div id="optic-fields" style="display:none;border-top:1px solid var(--border);padding-top:0.75rem;margin-top:0.25rem">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent);margin-bottom:0.75rem">Optic Details</div>
            <div><label>Zero Data</label><input name="zeroData" type="text" placeholder="e.g. 50yd zero, 12 clicks up" /></div>
          </div>
          <div><label>Notes</label><textarea name="notes" rows="2"></textarea></div>
          <button type="submit" class="btn btn-primary">Add Accessory</button>
        </form>
      </details>
      <script>
        function updateAccForm() {
          const type = document.getElementById('acc-type')?.value;
          const power = document.getElementById('acc-power')?.value;
          const lightFields = document.getElementById('light-fields');
          const opticFields = document.getElementById('optic-fields');
          const batteryFields = document.getElementById('battery-fields');
          if (lightFields) lightFields.style.display = type === 'light' ? 'block' : 'none';
          if (opticFields) opticFields.style.display = type === 'optic' ? 'block' : 'none';
          if (batteryFields) batteryFields.style.display = power === 'battery' ? 'block' : 'none';
        }
      </script>
    </div>

    <!-- Log -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">≡</span>
        <span class="section-title">Firearm Log</span>
      </div>
      {logs.length > 0 && (
        <div class="card card-divide" style="margin-bottom:0.75rem">
          {logs.map(l => (
            <div class="list-row" style="justify-content:space-between;align-items:flex-start">
              <div style="flex:1">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem">
                  <span>{logIcon[l.type] ?? '📋'}</span>
                  <span style="font-size:0.7rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted)">{l.type}</span>
                  <span style="font-size:0.7rem;color:var(--text-dim)">{l.date}</span>
                </div>
                <div style="font-size:0.875rem;color:var(--text);padding-left:1.5rem">{l.notes}</div>
                {l.roundCount && <div style="font-size:0.7rem;color:var(--text-dim);padding-left:1.5rem;margin-top:0.125rem">{l.roundCount.toLocaleString()} rounds at service</div>}
              </div>
              <form method="POST">
                <input type="hidden" name="_action" value="delete_log" />
                <input type="hidden" name="logId" value={l.id} />
                <button type="submit" class="btn-delete">✕</button>
              </form>
            </div>
          ))}
        </div>
      )}
      <details class="accordion">
        <summary>+ Add Log Entry</summary>
        <form method="POST" class="form-section">
          <input type="hidden" name="_action" value="add_maintenance" />
          <div class="form-row form-row-2">
            <div><label>Date *</label><input name="date" type="date" required /></div>
            <div>
              <label>Type</label>
              <select name="type">
                <option value="note">Note</option>
                <option value="cleaning">Cleaning</option>
                <option value="repair">Repair</option>
                <option value="inspection">Inspection</option>
                <option value="modification">Modification</option>
              </select>
            </div>
          </div>
          <div><label>Notes *</label><textarea name="notes" rows="3" required placeholder="What happened, what was done..."></textarea></div>
          <div><label>Round Count at Service</label><input name="roundCount" type="number" min="0" placeholder="Optional" /></div>
          <button type="submit" class="btn btn-primary">Save Entry</button>
        </form>
      </details>
    </div>

    <!-- Delete -->
    <form method="POST" onsubmit="return confirm('Delete this firearm and all its records?')">
      <input type="hidden" name="_action" value="delete" />
      <button type="submit" class="btn btn-danger btn-full">Delete Firearm</button>
    </form>

  </div>
</Layout>
