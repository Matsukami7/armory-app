---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { firearms } from '../../db/schema';
import { sql } from 'drizzle-orm';

const all = await db.select().from(firearms).orderBy(sql`created_at DESC`);

const typeLabel: Record<string, string> = {
  pistol: 'Pistol', rifle: 'Rifle', shotgun: 'Shotgun', revolver: 'Revolver', other: 'Other'
};
---

<Layout title="Firearms">
  <div class="px-4 py-5">
    <div class="flex items-center justify-between mb-4">
      <span class="text-sm text-zinc-500">{all.length} firearm{all.length !== 1 ? 's' : ''}</span>
      <a href="/firearms/new" class="btn-primary py-2">+ Add</a>
    </div>

    {all.length === 0 ? (
      <div class="text-center py-16 text-zinc-600">
        <div class="text-4xl mb-3">🔫</div>
        <p class="text-sm">No firearms yet.</p>
        <a href="/firearms/new" class="btn-primary mt-4 inline-flex">Add Firearm</a>
      </div>
    ) : (
      <div class="card divide-y divide-zinc-800">
        {all.map(f => (
          <a href={`/firearms/${f.id}`} class="flex items-center gap-3 px-4 py-3.5 hover:bg-zinc-800/50 transition-colors">
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm truncate">{f.name}</div>
              <div class="text-xs text-zinc-500">{f.make} {f.model}{f.generation ? ` ${f.generation}` : ''} · {f.caliber} · {typeLabel[f.type] ?? f.type}</div>
            </div>
            <svg class="w-4 h-4 text-zinc-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
