---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { firearms } from '../../db/schema';
import { sql } from 'drizzle-orm';
import { parseTags, tagColor } from '../../lib/tags';

const typeFilter     = Astro.url.searchParams.get('type') ?? 'all';
const tagFilter      = Astro.url.searchParams.get('tag') ?? '';
const showTransferred = Astro.url.searchParams.get('show') === 'all';

const all = await db.select().from(firearms).orderBy(sql`created_at DESC`);
const active = all.filter(f => f.status === 'active');
const displayBase = showTransferred ? all : active;

const filtered = displayBase
  .filter(f => typeFilter === 'all' || f.type === typeFilter)
  .filter(f => !tagFilter || parseTags(f.tags).includes(tagFilter));

const counts: Record<string, number> = { all: displayBase.length };
for (const f of displayBase) counts[f.type] = (counts[f.type] ?? 0) + 1;

const transferredCount = all.filter(f => f.status !== 'active').length;

// Collect all unique tags across displayed firearms
const allTags = [...new Set(displayBase.flatMap(f => parseTags(f.tags)))].sort();

const types = ['pistol', 'rifle', 'shotgun', 'revolver', 'other'];
const typeLabel: Record<string, string> = {
  pistol: 'Pistol', rifle: 'Rifle', shotgun: 'Shotgun', revolver: 'Revolver', other: 'Other'
};
const typeIcon: Record<string, string> = {
  pistol:   `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
  rifle:    `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />`,
  shotgun:  `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
  revolver: `<circle cx="12" cy="12" r="3" stroke-width="1" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 3v2m0 14v2M3 12h2m14 0h2m-3.22-6.78-1.42 1.42M6.64 17.36l-1.42 1.42M17.36 17.36l-1.42-1.42M6.64 6.64 5.22 5.22" />`,
  other:    `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />`,
};
---

<Layout title="Vault" sub={`${active.length} active · ${transferredCount > 0 ? `${transferredCount} transferred/sold` : 'none transferred'}`}>
  <slot name="actions" slot="actions">
    {transferredCount > 0 && (
      <a href={showTransferred ? '/firearms' : '/firearms?show=all'} class="btn btn-secondary" style="font-size:0.75rem">
        {showTransferred ? 'Hide Transferred' : `Show Transferred (${transferredCount})`}
      </a>
    )}
    <a href="/firearms/new" class="btn btn-primary">+ Add Firearm</a>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.25rem">

    <!-- Filter tabs -->
    {all.length > 0 && (
      <div class="filter-tabs">
        <a href="/firearms" class={`filter-tab ${typeFilter === 'all' ? 'active' : ''}`}>
          All <span style="opacity:0.6;margin-left:0.25rem">{counts.all}</span>
        </a>
        {types.filter(t => counts[t]).map(t => (
          <a href={`/firearms?type=${t}`} class={`filter-tab ${typeFilter === t ? 'active' : ''}`}>
            {typeLabel[t]} <span style="opacity:0.6;margin-left:0.25rem">{counts[t]}</span>
          </a>
        ))}
      </div>
    )}

    <!-- Tag filter chips -->
    {allTags.length > 0 && (
      <div style="display:flex;flex-wrap:wrap;gap:0.4rem;align-items:center">
        <span style="font-size:0.65rem;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-dim)">Tags:</span>
        {tagFilter && (
          <a href={typeFilter === 'all' ? '/firearms' : `/firearms?type=${typeFilter}`}
             style="font-size:0.72rem;padding:0.15rem 0.5rem;border-radius:9999px;background:rgba(255,255,255,0.08);color:var(--text-muted);border:1px solid rgba(255,255,255,0.15);text-decoration:none">
            ✕ clear
          </a>
        )}
        {allTags.map(t => {
          const color = tagColor(t);
          const active = tagFilter === t;
          const href = typeFilter === 'all' ? `/firearms?tag=${t}` : `/firearms?type=${typeFilter}&tag=${t}`;
          return (
            <a href={href}
               style={`font-size:0.72rem;padding:0.15rem 0.5rem;border-radius:9999px;text-decoration:none;border:1px solid ${color}44;color:${color};background:${active ? color + '22' : 'transparent'};font-weight:${active ? '700' : '400'}`}>
              {t}
            </a>
          );
        })}
      </div>
    )}

    <!-- Card grid -->
    {filtered.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-icon">🔫</div>
        <div class="empty-state-text">{typeFilter === 'all' ? 'No firearms yet.' : `No ${typeLabel[typeFilter] ?? typeFilter}s in vault.`}</div>
        {typeFilter === 'all' && <a href="/firearms/new" class="btn btn-primary">Add Firearm</a>}
      </div>
    ) : (
      <div class="firearm-grid">
        {filtered.map(f => (
          <a href={`/firearms/${f.id}`} class="firearm-card">
            <div class="firearm-card-photo">
              {f.photoPath
                ? <img src={f.photoPath} alt={f.name} />
                : (
                  <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text-dim)" set:html={typeIcon[f.type] ?? typeIcon.other} />
                )
              }
              <span class="firearm-card-type-badge">{typeLabel[f.type] ?? f.type}</span>
            </div>
            <div class="firearm-card-body">
              <div class="firearm-card-name">{f.name}</div>
              <div class="firearm-card-sub">
                {f.make} · {f.model}{f.generation ? ` ${f.generation}` : ''}
              </div>
              {f.serial && (
                <div style="font-size:0.7rem;color:var(--text-dim)">
                  <span style="letter-spacing:0.08em;text-transform:uppercase">Serial</span>
                  &nbsp;{f.serial}
                </div>
              )}
              <div class="firearm-card-pills">
                <span class="pill pill-default">{f.caliber}</span>
                {f.purchasePrice && (
                  <span class="pill" style="background:rgba(34,197,94,0.08);color:#4ade80;border:1px solid rgba(34,197,94,0.2)">
                    ${f.purchasePrice.toLocaleString()}
                  </span>
                )}
                {parseTags(f.tags).map(t => {
                  const color = tagColor(t);
                  return <span style={`font-size:0.65rem;padding:0.1rem 0.4rem;border-radius:9999px;border:1px solid ${color}44;color:${color}`}>{t}</span>;
                })}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

  </div>
</Layout>
