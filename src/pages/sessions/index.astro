---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { rangeSessions, sessionFirearms } from '../../db/schema';
import { sql, sum } from 'drizzle-orm';

const sessions = await db.select().from(rangeSessions).orderBy(sql`date DESC`);
const roundsBySession = await db
  .select({ sessionId: sessionFirearms.sessionId, total: sum(sessionFirearms.roundsFired) })
  .from(sessionFirearms)
  .groupBy(sessionFirearms.sessionId);
const roundsMap = new Map(roundsBySession.map(r => [r.sessionId, Number(r.total)]));
---

<Layout title="Range" sub="Sessions & drills">
  <slot name="actions" slot="actions">
    <a href="/sessions/new" class="btn btn-primary">+ Log Session</a>
  </slot>

  {sessions.length === 0 ? (
    <div class="empty-state">
      <div class="empty-state-icon">🎯</div>
      <div class="empty-state-text">No sessions logged yet.</div>
      <a href="/sessions/new" class="btn btn-primary">Log a Session</a>
    </div>
  ) : (
    <div class="card card-divide">
      {sessions.map(s => (
        <a href={`/sessions/${s.id}`} class="list-row list-row-link" style="justify-content:space-between">
          <div>
            <div style="font-size:0.875rem;font-weight:600;color:var(--text)">{s.date}</div>
            <div style="font-size:0.75rem;color:var(--text-muted)">
              {s.location ?? 'No location'}{s.durationMinutes ? ` · ${s.durationMinutes}min` : ''}
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:1rem">
            {roundsMap.has(s.id) && (
              <span style="font-size:0.8125rem;font-weight:700;color:#f97316">
                {(roundsMap.get(s.id) ?? 0).toLocaleString()} rds
              </span>
            )}
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:var(--text-dim)">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>
