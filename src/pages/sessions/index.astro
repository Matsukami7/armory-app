---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { rangeSessions, sessionFirearms } from '../../db/schema';
import { sql, sum } from 'drizzle-orm';

const sessions = await db.select().from(rangeSessions).orderBy(sql`date DESC`);
const roundsBySession = await db
  .select({ sessionId: sessionFirearms.sessionId, total: sum(sessionFirearms.roundsFired) })
  .from(sessionFirearms)
  .groupBy(sessionFirearms.sessionId);

const roundsMap = new Map(roundsBySession.map(r => [r.sessionId, Number(r.total)]));
---

<Layout title="Range Sessions">
  <div class="px-4 py-5">
    <div class="flex items-center justify-between mb-4">
      <span class="text-sm text-zinc-500">{sessions.length} session{sessions.length !== 1 ? 's' : ''}</span>
      <a href="/sessions/new" class="btn-primary py-2">+ Log</a>
    </div>

    {sessions.length === 0 ? (
      <div class="text-center py-16 text-zinc-600">
        <div class="text-4xl mb-3">🎯</div>
        <p class="text-sm">No sessions logged yet.</p>
        <a href="/sessions/new" class="btn-primary mt-4 inline-flex">Log a Session</a>
      </div>
    ) : (
      <div class="card divide-y divide-zinc-800">
        {sessions.map(s => (
          <a href={`/sessions/${s.id}`} class="flex items-center justify-between px-4 py-3.5 hover:bg-zinc-800/50 transition-colors">
            <div>
              <div class="text-sm font-medium">{s.date}</div>
              <div class="text-xs text-zinc-500">
                {s.location ?? 'No location'}
                {s.durationMinutes ? ` · ${s.durationMinutes}min` : ''}
              </div>
            </div>
            <div class="flex items-center gap-3">
              {roundsMap.has(s.id) && (
                <span class="text-sm font-semibold text-amber-400">{(roundsMap.get(s.id) ?? 0).toLocaleString()} rds</span>
              )}
              <svg class="w-4 h-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
