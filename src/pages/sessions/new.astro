---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { rangeSessions, sessionTemplates, sessionTemplateFirearms, firearms, ammoInventory } from '../../db/schema';
import { eq, isNotNull } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const [inserted] = await db.insert(rangeSessions).values({
    date:            form.get('date') as string,
    location:        form.get('location') as string || null,
    durationMinutes: form.get('durationMinutes') ? parseInt(form.get('durationMinutes') as string) : null,
    weather:         form.get('weather') as string || null,
    notes:           form.get('notes') as string || null,
  }).returning({ id: rangeSessions.id });
  return Astro.redirect(`/sessions/${inserted.id}`);
}

const today = new Date().toISOString().split('T')[0];
const locationRows = await db.selectDistinct({ location: rangeSessions.location }).from(rangeSessions).where(isNotNull(rangeSessions.location)).orderBy(rangeSessions.location);
const pastLocations = locationRows.map(r => r.location as string);

// Load template if ?template= is set
const templateId = parseInt(Astro.url.searchParams.get('template') ?? '') || null;
let templateData: { name: string; location: string | null; notes: string | null } | null = null;
if (templateId) {
  const [tmpl] = await db.select().from(sessionTemplates).where(eq(sessionTemplates.id, templateId));
  if (tmpl) templateData = tmpl;
}

const templates = await db.select().from(sessionTemplates).orderBy(sessionTemplates.name);
---

<Layout title="Log Session" backHref="/sessions">
  <slot name="actions" slot="actions">
    {templates.length > 0 && (
      <a href="/sessions/templates" class="btn btn-secondary" style="font-size:0.75rem">Manage Templates</a>
    )}
    {templates.length === 0 && (
      <a href="/sessions/templates" class="btn btn-secondary" style="font-size:0.75rem">+ Create Template</a>
    )}
  </slot>

  {templateData && (
    <div style="margin-bottom:1rem;padding:0.625rem 1rem;background:rgba(var(--accent-rgb,6,182,212),0.08);border:1px solid rgba(var(--accent-rgb,6,182,212),0.2);border-radius:0.5rem;font-size:0.8rem;color:var(--text-muted)">
      Template loaded: <strong style="color:var(--accent)">{templateData.name}</strong>
      <a href="/sessions/new" style="margin-left:0.75rem;font-size:0.72rem;color:var(--text-dim)">clear</a>
    </div>
  )}

  {templates.length > 0 && !templateData && (
    <div style="margin-bottom:1rem;display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap">
      <span style="font-size:0.72rem;color:var(--text-muted)">Load template:</span>
      {templates.map(t => (
        <a href={`/sessions/new?template=${t.id}`} class="pill pill-default" style="font-size:0.72rem;text-decoration:none">{t.name}</a>
      ))}
    </div>
  )}

  <form method="POST" class="form-section" style="max-width:36rem">

    <div class="form-row form-row-2">
      <div><label>Date *</label><input name="date" type="date" required value={today} /></div>
      <div><label>Duration (min)</label><input name="durationMinutes" type="number" min="1" placeholder="60" /></div>
    </div>

    <datalist id="locations">
      {pastLocations.map(loc => <option value={loc} />)}
    </datalist>
    <div><label>Location / Range</label><input name="location" type="text" list="locations" placeholder="e.g. Oakwood Indoor Range" value={templateData?.location ?? ''} /></div>

    <div>
      <label>Weather / Conditions</label>
      <div style="display:flex;gap:0.5rem;align-items:center">
        <input id="weather-input" name="weather" type="text" placeholder="e.g. Sunny, 75°F, light wind" style="flex:1" />
        <button type="button" id="weather-btn" class="btn btn-secondary" style="white-space:nowrap;flex-shrink:0">
          Get Weather
        </button>
      </div>
      <div id="weather-status" style="font-size:0.7rem;color:var(--text-muted);margin-top:0.25rem;min-height:1em"></div>
    </div>

    <div><label>Session Notes</label><textarea name="notes" rows="3" placeholder="Goals, observations, etc.">{templateData?.notes ?? ''}</textarea></div>

    <p style="font-size:0.75rem;color:var(--text-muted)">Firearms, ammo, and drills can be added after saving.</p>

    <button type="submit" class="btn btn-primary btn-full">Create Session</button>
  </form>
</Layout>

<script>
const btn = document.getElementById('weather-btn') as HTMLButtonElement;
const input = document.getElementById('weather-input') as HTMLInputElement;
const status = document.getElementById('weather-status')!;

const WMO: Record<number, string> = {
  0:'Clear',1:'Mainly Clear',2:'Partly Cloudy',3:'Overcast',
  45:'Foggy',48:'Icy Fog',
  51:'Light Drizzle',53:'Drizzle',55:'Heavy Drizzle',
  61:'Light Rain',63:'Rain',65:'Heavy Rain',
  71:'Light Snow',73:'Snow',75:'Heavy Snow',
  77:'Snow Grains',
  80:'Light Showers',81:'Showers',82:'Heavy Showers',
  85:'Snow Showers',86:'Heavy Snow Showers',
  95:'Thunderstorm',96:'Thunderstorm w/ Hail',99:'Thunderstorm w/ Heavy Hail',
};

btn.addEventListener('click', async () => {
  if (!navigator.geolocation) { status.textContent = 'Geolocation not supported'; return; }
  btn.disabled = true;
  status.textContent = 'Getting location…';
  navigator.geolocation.getCurrentPosition(async pos => {
    const { latitude: lat, longitude: lon } = pos.coords;
    status.textContent = 'Fetching weather…';
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat.toFixed(4)}&longitude=${lon.toFixed(4)}&current=temperature_2m,wind_speed_10m,weather_code&temperature_unit=fahrenheit&wind_speed_unit=mph&timezone=auto`;
      const res = await fetch(url);
      const data = await res.json();
      const c = data.current;
      const desc = WMO[c.weather_code] ?? 'Unknown';
      const temp = Math.round(c.temperature_2m);
      const wind = Math.round(c.wind_speed_10m);
      input.value = `${desc}, ${temp}°F, Wind ${wind}mph`;
      status.textContent = '';
    } catch {
      status.textContent = 'Weather lookup failed';
    } finally {
      btn.disabled = false;
    }
  }, () => {
    status.textContent = 'Location access denied';
    btn.disabled = false;
  });
});
</script>
