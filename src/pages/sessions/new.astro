---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { rangeSessions } from '../../db/schema';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const [inserted] = await db.insert(rangeSessions).values({
    date:            form.get('date') as string,
    location:        form.get('location') as string || null,
    durationMinutes: form.get('durationMinutes') ? parseInt(form.get('durationMinutes') as string) : null,
    weather:         form.get('weather') as string || null,
    notes:           form.get('notes') as string || null,
  }).returning({ id: rangeSessions.id });
  return Astro.redirect(`/sessions/${inserted.id}`);
}

const today = new Date().toISOString().split('T')[0];
---

<Layout title="Log Session" backHref="/sessions">
  <form method="POST" class="form-section" style="max-width:36rem">

    <div class="form-row form-row-2">
      <div><label>Date *</label><input name="date" type="date" required value={today} /></div>
      <div><label>Duration (min)</label><input name="durationMinutes" type="number" min="1" placeholder="60" /></div>
    </div>

    <div><label>Location / Range</label><input name="location" type="text" placeholder="e.g. Oakwood Indoor Range" /></div>

    <div><label>Weather / Conditions</label><input name="weather" type="text" placeholder="e.g. Sunny, 75°F, light wind" /></div>

    <div><label>Session Notes</label><textarea name="notes" rows="3" placeholder="Goals, observations, etc."></textarea></div>

    <p style="font-size:0.75rem;color:var(--text-muted)">Firearms, ammo, and drills can be added after saving.</p>

    <button type="submit" class="btn btn-primary btn-full">Create Session</button>
  </form>
</Layout>
