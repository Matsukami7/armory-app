---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { rangeSessions, sessionFirearms, firearms, ammoInventory, drills } from '../../db/schema';
import { eq, sql } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/sessions');

const [session] = await db.select().from(rangeSessions).where(eq(rangeSessions.id, id));
if (!session) return Astro.redirect('/sessions');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    await db.delete(rangeSessions).where(eq(rangeSessions.id, id));
    return Astro.redirect('/sessions');
  }
  if (action === 'add_firearm') {
    const firearmId  = parseInt(form.get('firearmId') as string);
    const roundsFired = parseInt(form.get('roundsFired') as string) || 0;
    const ammoId     = form.get('ammoId') ? parseInt(form.get('ammoId') as string) : null;
    await db.insert(sessionFirearms).values({ sessionId: id, firearmId, roundsFired, ammoId });
    if (ammoId && roundsFired > 0)
      await db.run(sql`UPDATE ammo_inventory SET quantity = MAX(0, quantity - ${roundsFired}) WHERE id = ${ammoId}`);
  }
  if (action === 'remove_firearm') {
    await db.delete(sessionFirearms).where(eq(sessionFirearms.id, parseInt(form.get('sfId') as string)));
  }
  if (action === 'add_drill') {
    await db.insert(drills).values({
      sessionId:  id,
      firearmId:  form.get('firearmId') ? parseInt(form.get('firearmId') as string) : null,
      name:       form.get('name') as string,
      distance:   form.get('distance') as string || null,
      score:      form.get('score') as string || null,
      notes:      form.get('notes') as string || null,
    });
  }
  if (action === 'remove_drill') {
    await db.delete(drills).where(eq(drills.id, parseInt(form.get('drillId') as string)));
  }
  return Astro.redirect(`/sessions/${id}`);
}

const sessionGuns = await db
  .select({ sf: sessionFirearms, f: firearms, a: ammoInventory })
  .from(sessionFirearms)
  .leftJoin(firearms,      eq(sessionFirearms.firearmId, firearms.id))
  .leftJoin(ammoInventory, eq(sessionFirearms.ammoId, ammoInventory.id))
  .where(eq(sessionFirearms.sessionId, id));

const sessionDrills = await db.select().from(drills).where(eq(drills.sessionId, id));
const allFirearms   = await db.select().from(firearms);
const allAmmo       = await db.select().from(ammoInventory);
const totalRounds   = sessionGuns.reduce((s, r) => s + r.sf.roundsFired, 0);
---

<Layout
  title={`Session · ${session.date}`}
  sub={[session.location, session.durationMinutes ? `${session.durationMinutes}min` : null].filter(Boolean).join(' · ')}
  backHref="/sessions"
>
  <slot name="actions" slot="actions">
    <a href={`/sessions/${id}/edit`} class="btn btn-secondary">Edit</a>
  </slot>

  <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:52rem">

    <!-- Overview -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem">
      <div class="stat-card">
        <div>
          <div class="stat-card-label">Rounds Fired</div>
          <div class="stat-card-value" style="color:#f97316">{totalRounds.toLocaleString()}</div>
        </div>
      </div>
      {session.weather && (
        <div class="stat-card">
          <div>
            <div class="stat-card-label">Conditions</div>
            <div style="font-size:0.875rem;font-weight:600;color:var(--text);margin-top:0.25rem">{session.weather}</div>
          </div>
        </div>
      )}
    </div>

    {session.notes && (
      <div class="card" style="padding:1.25rem">
        <div style="font-size:0.6rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:0.5rem">Session Notes</div>
        <p style="font-size:0.875rem;color:var(--text-muted);line-height:1.6">{session.notes}</p>
      </div>
    )}

    <!-- Firearms used -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">◉</span>
        <span class="section-title">Firearms Used</span>
      </div>
      {sessionGuns.length > 0 && (
        <div class="card card-divide" style="margin-bottom:0.75rem">
          {sessionGuns.map(r => (
            <div class="list-row" style="justify-content:space-between">
              <div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--text)">{r.f?.name ?? 'Unknown'}</div>
                {r.a && <div style="font-size:0.75rem;color:var(--text-muted)">{r.a.brand} {r.a.grain}gr {r.a.caliber}</div>}
              </div>
              <div style="display:flex;align-items:center;gap:0.75rem">
                <span style="font-size:0.875rem;font-weight:700;color:#f97316">{r.sf.roundsFired} rds</span>
                <form method="POST">
                  <input type="hidden" name="_action" value="remove_firearm" />
                  <input type="hidden" name="sfId" value={r.sf.id} />
                  <button type="submit" class="btn-delete">✕</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      )}
      <details class="accordion">
        <summary>+ Add Firearm</summary>
        <form method="POST" class="form-section">
          <input type="hidden" name="_action" value="add_firearm" />
          <div>
            <label>Firearm *</label>
            <select name="firearmId" required id="sf-firearm" onchange="filterAmmo()">
              <option value="">Select...</option>
              {allFirearms.map(f => <option value={f.id} data-caliber={f.caliber}>{f.name} ({f.caliber})</option>)}
            </select>
          </div>
          <div class="form-row form-row-2">
            <div><label>Rounds Fired</label><input name="roundsFired" type="number" min="0" placeholder="0" /></div>
            <div>
              <label>Ammo Used</label>
              <select name="ammoId" id="sf-ammo">
                <option value="">None</option>
                {allAmmo.map(a => <option value={a.id} data-caliber={a.caliber}>{a.brand} {a.grain}gr {a.caliber} ({a.quantity} left)</option>)}
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary">Add</button>
        </form>
      </details>

      <script>
        function filterAmmo() {
          const firearmSel = document.getElementById('sf-firearm');
          const ammoSel = document.getElementById('sf-ammo');
          if (!firearmSel || !ammoSel) return;
          const selected = firearmSel.options[firearmSel.selectedIndex];
          const caliber = selected?.dataset?.caliber ?? '';
          Array.from(ammoSel.options).forEach(opt => {
            if (!opt.value) return; // keep the "None" option
            opt.hidden = caliber ? opt.dataset.caliber !== caliber : false;
          });
          // Reset to "None" if current selection no longer matches
          const cur = ammoSel.options[ammoSel.selectedIndex];
          if (cur?.hidden) ammoSel.value = '';
        }
      </script>
    </div>

    <!-- Drills -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">◎</span>
        <span class="section-title">Drills</span>
      </div>
      {sessionDrills.length > 0 && (
        <div class="card card-divide" style="margin-bottom:0.75rem">
          {sessionDrills.map(d => (
            <div class="list-row" style="justify-content:space-between;align-items:flex-start">
              <div style="flex:1">
                <div style="display:flex;align-items:center;gap:0.75rem">
                  <span style="font-size:0.875rem;font-weight:600;color:var(--text)">{d.name}</span>
                  {d.score && <span class="pill pill-accent">{d.score}</span>}
                </div>
                {d.distance && <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.125rem">{d.distance}</div>}
                {d.notes && <div style="font-size:0.8125rem;color:var(--text-muted);margin-top:0.25rem">{d.notes}</div>}
              </div>
              <form method="POST">
                <input type="hidden" name="_action" value="remove_drill" />
                <input type="hidden" name="drillId" value={d.id} />
                <button type="submit" class="btn-delete">✕</button>
              </form>
            </div>
          ))}
        </div>
      )}
      <details class="accordion">
        <summary>+ Log Drill</summary>
        <form method="POST" class="form-section">
          <input type="hidden" name="_action" value="add_drill" />
          <div><label>Drill Name *</label><input name="name" type="text" required placeholder="e.g. Dot Torture, FAST Drill" /></div>
          <div class="form-row form-row-2">
            <div><label>Distance</label><input name="distance" type="text" placeholder="e.g. 7 yards" /></div>
            <div><label>Score / Result</label><input name="score" type="text" placeholder="e.g. 48/50" /></div>
          </div>
          <div>
            <label>Firearm</label>
            <select name="firearmId">
              <option value="">Select...</option>
              {allFirearms.map(f => <option value={f.id}>{f.name}</option>)}
            </select>
          </div>
          <div><label>Notes</label><textarea name="notes" rows="2" placeholder="Observations, what to work on..."></textarea></div>
          <button type="submit" class="btn btn-primary">Add Drill</button>
        </form>
      </details>
    </div>

    <!-- Delete -->
    <form method="POST" onsubmit="return confirm('Delete this session?')">
      <input type="hidden" name="_action" value="delete" />
      <button type="submit" class="btn btn-danger btn-full">Delete Session</button>
    </form>

  </div>
</Layout>
