---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../db';
import { rangeSessions } from '../../../db/schema';
import { eq, isNotNull } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/sessions');

const [session] = await db.select().from(rangeSessions).where(eq(rangeSessions.id, id));
if (!session) return Astro.redirect('/sessions');

const locationRows = await db.selectDistinct({ location: rangeSessions.location }).from(rangeSessions).where(isNotNull(rangeSessions.location)).orderBy(rangeSessions.location);
const pastLocations = locationRows.map(r => r.location as string);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  await db.update(rangeSessions).set({
    date:            form.get('date') as string,
    location:        form.get('location') as string || null,
    durationMinutes: form.get('durationMinutes') ? parseInt(form.get('durationMinutes') as string) : null,
    weather:         form.get('weather') as string || null,
    notes:           form.get('notes') as string || null,
  }).where(eq(rangeSessions.id, id));
  return Astro.redirect(`/sessions/${id}`);
}
---

<Layout title="Edit Session" backHref={`/sessions/${id}`}>
  <form method="POST" class="form-section" style="max-width:36rem">

    <div class="form-row form-row-2">
      <div><label>Date *</label><input name="date" type="date" required value={session.date} /></div>
      <div><label>Duration (min)</label><input name="durationMinutes" type="number" min="1" value={session.durationMinutes ?? ''} /></div>
    </div>

    <datalist id="locations">
      {pastLocations.map(loc => <option value={loc} />)}
    </datalist>
    <div><label>Location / Range</label><input name="location" type="text" list="locations" value={session.location ?? ''} /></div>

    <div><label>Weather / Conditions</label><input name="weather" type="text" value={session.weather ?? ''} /></div>

    <div><label>Session Notes</label><textarea name="notes" rows="4">{session.notes ?? ''}</textarea></div>

    <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
  </form>
</Layout>
