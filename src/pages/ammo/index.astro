---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { ammoInventory } from '../../db/schema';
import { sql } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'add') {
    await db.insert(ammoInventory).values({
      caliber: form.get('caliber') as string,
      brand: form.get('brand') as string,
      grain: form.get('grain') ? parseInt(form.get('grain') as string) : null,
      type: form.get('type') as string,
      quantity: parseInt(form.get('quantity') as string) || 0,
      costPerRound: form.get('costPerRound') ? parseFloat(form.get('costPerRound') as string) : null,
      notes: form.get('notes') as string || null,
    });
  }

  if (action === 'adjust') {
    const id = parseInt(form.get('id') as string);
    const delta = parseInt(form.get('delta') as string);
    await db.run(sql`UPDATE ammo_inventory SET quantity = MAX(0, quantity + ${delta}) WHERE id = ${id}`);
  }

  return Astro.redirect('/ammo');
}

const all = await db.select().from(ammoInventory).orderBy(sql`caliber, brand`);
const totalRounds = all.reduce((sum, a) => sum + a.quantity, 0);
---

<Layout title="Ammo">
  <div class="px-4 py-5 space-y-6">

    <div class="flex items-center justify-between">
      <span class="text-sm text-zinc-500">{totalRounds.toLocaleString()} rounds total</span>
    </div>

    {all.length > 0 && (
      <div class="card divide-y divide-zinc-800">
        {all.map(a => (
          <div class="px-4 py-3">
            <div class="flex items-start justify-between gap-3">
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium">{a.brand} {a.grain ? `${a.grain}gr` : ''} {a.caliber}</div>
                <div class="text-xs text-zinc-500">{a.type}{a.costPerRound ? ` · $${a.costPerRound.toFixed(3)}/rd` : ''}</div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <form method="POST" class="flex items-center gap-1">
                  <input type="hidden" name="_action" value="adjust" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="delta" value="-50" />
                  <button type="submit" class="btn-secondary py-1 px-2 text-xs">-50</button>
                </form>
                <span class={`text-base font-bold w-12 text-center ${a.quantity < 50 ? 'text-red-400' : a.quantity < 200 ? 'text-amber-400' : 'text-zinc-100'}`}>
                  {a.quantity.toLocaleString()}
                </span>
                <form method="POST" class="flex items-center gap-1">
                  <input type="hidden" name="_action" value="adjust" />
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="delta" value="50" />
                  <button type="submit" class="btn-secondary py-1 px-2 text-xs">+50</button>
                </form>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Add ammo form -->
    <div>
      <h2 class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-3">Add Ammo</h2>
      <form method="POST" class="card p-4 space-y-3">
        <input type="hidden" name="_action" value="add" />

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label>Caliber *</label>
            <input name="caliber" type="text" required placeholder="9mm" />
          </div>
          <div>
            <label>Brand *</label>
            <input name="brand" type="text" required placeholder="Federal" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label>Grain</label>
            <input name="grain" type="number" min="1" placeholder="115" />
          </div>
          <div>
            <label>Type *</label>
            <select name="type">
              <option value="FMJ">FMJ</option>
              <option value="HP">HP</option>
              <option value="SP">SP</option>
              <option value="match">Match</option>
              <option value="subsonic">Subsonic</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label>Quantity *</label>
            <input name="quantity" type="number" min="0" required placeholder="0" />
          </div>
          <div>
            <label>Cost/Round ($)</label>
            <input name="costPerRound" type="number" step="0.001" min="0" placeholder="0.000" />
          </div>
        </div>

        <div>
          <label>Notes</label>
          <input name="notes" type="text" placeholder="Optional" />
        </div>

        <button type="submit" class="btn-primary w-full">Add Ammo</button>
      </form>
    </div>

  </div>
</Layout>
