---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { ammoInventory } from '../../db/schema';
import { sql } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'add') {
    await db.insert(ammoInventory).values({
      caliber:      form.get('caliber') as string,
      brand:        form.get('brand') as string,
      grain:        form.get('grain') ? parseInt(form.get('grain') as string) : null,
      type:         form.get('type') as string,
      quantity:     parseInt(form.get('quantity') as string) || 0,
      costPerRound: form.get('costPerRound') ? parseFloat(form.get('costPerRound') as string) : null,
      notes:        form.get('notes') as string || null,
    });
  }

  if (action === 'adjust') {
    const id    = parseInt(form.get('id') as string);
    const delta = parseInt(form.get('delta') as string);
    await db.run(sql`UPDATE ammo_inventory SET quantity = MAX(0, quantity + ${delta}) WHERE id = ${id}`);
  }

  return Astro.redirect('/ammo');
}

const all = await db.select().from(ammoInventory).orderBy(sql`caliber, brand`);
const totalRounds = all.reduce((s, a) => s + a.quantity, 0);
---

<Layout title="Ammo" sub={`${totalRounds.toLocaleString()} rounds total`}>

  <div style="display:flex;flex-direction:column;gap:1.5rem">

    <!-- Inventory -->
    {all.length > 0 && (
      <div class="card card-divide">
        {all.map(a => (
          <div class="list-row" style="justify-content:space-between;gap:1rem">
            <div style="flex:1;min-width:0">
              <div style="font-size:0.875rem;font-weight:600;color:var(--text)">
                {a.brand} {a.grain ? `${a.grain}gr` : ''} {a.caliber}
              </div>
              <div style="font-size:0.75rem;color:var(--text-muted)">
                {a.type}{a.costPerRound ? ` · $${a.costPerRound.toFixed(3)}/rd` : ''}
                {a.notes ? ` · ${a.notes}` : ''}
              </div>
            </div>
            <div style="display:flex;align-items:center;gap:0.5rem;flex-shrink:0">
              <form method="POST">
                <input type="hidden" name="_action" value="adjust" />
                <input type="hidden" name="id" value={a.id} />
                <input type="hidden" name="delta" value="-50" />
                <button type="submit" class="btn btn-secondary btn-sm">−50</button>
              </form>
              <span style={`font-size:1rem;font-weight:800;width:3.5rem;text-align:center;color:${a.quantity < 50 ? '#f87171' : a.quantity < 200 ? '#f97316' : 'var(--text)'}`}>
                {a.quantity.toLocaleString()}
              </span>
              <form method="POST">
                <input type="hidden" name="_action" value="adjust" />
                <input type="hidden" name="id" value={a.id} />
                <input type="hidden" name="delta" value="50" />
                <button type="submit" class="btn btn-secondary btn-sm">+50</button>
              </form>
              <a href={`/ammo/${a.id}/edit`} class="btn btn-secondary btn-sm">Edit</a>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Add form -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">+</span>
        <span class="section-title">Add Ammo</span>
      </div>
      <form method="POST" class="card" style="padding:1.5rem">
        <input type="hidden" name="_action" value="add" />
        <div class="form-section">
          <div class="form-row form-row-2">
            <div><label>Caliber *</label><input name="caliber" type="text" required placeholder="9mm" /></div>
            <div><label>Brand *</label><input name="brand" type="text" required placeholder="Federal" /></div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Grain</label><input name="grain" type="number" min="1" placeholder="115" /></div>
            <div>
              <label>Type *</label>
              <select name="type">
                <option value="FMJ">FMJ</option>
                <option value="HP">HP</option>
                <option value="SP">SP</option>
                <option value="match">Match</option>
                <option value="subsonic">Subsonic</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Quantity *</label><input name="quantity" type="number" min="0" required placeholder="0" /></div>
            <div><label>Cost / Round ($)</label><input name="costPerRound" type="number" step="0.001" min="0" placeholder="0.000" /></div>
          </div>
          <div><label>Notes</label><input name="notes" type="text" placeholder="Optional" /></div>
          <button type="submit" class="btn btn-primary btn-full">Add Ammo</button>
        </div>
      </form>
    </div>

  </div>
</Layout>
