---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../db';
import { ammoInventory, ammoPurchases } from '../../../db/schema';
import { eq, desc, sql } from 'drizzle-orm';

const id = parseInt(Astro.params.id!);
if (isNaN(id)) return Astro.redirect('/ammo');

const [ammo] = await db.select().from(ammoInventory).where(eq(ammoInventory.id, id));
if (!ammo) return Astro.redirect('/ammo');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'delete') {
    await db.delete(ammoInventory).where(eq(ammoInventory.id, id));
    return Astro.redirect('/ammo');
  }

  if (action === 'log_purchase') {
    const qty = parseInt(form.get('quantity') as string) || 0;
    await db.insert(ammoPurchases).values({
      ammoId:    id,
      date:      form.get('date') as string,
      quantity:  qty,
      totalCost: form.get('totalCost') ? parseFloat(form.get('totalCost') as string) : null,
      source:    form.get('source') as string || null,
      notes:     form.get('notes') as string || null,
    });
    if (qty > 0)
      await db.run(sql`UPDATE ammo_inventory SET quantity = quantity + ${qty} WHERE id = ${id}`);
    return Astro.redirect(`/ammo/${id}/edit`);
  }

  if (action === 'delete_purchase') {
    const purchaseId = parseInt(form.get('purchaseId') as string);
    const [purchase] = await db.select().from(ammoPurchases).where(eq(ammoPurchases.id, purchaseId));
    if (purchase) {
      await db.delete(ammoPurchases).where(eq(ammoPurchases.id, purchaseId));
      await db.run(sql`UPDATE ammo_inventory SET quantity = MAX(0, quantity - ${purchase.quantity}) WHERE id = ${id}`);
    }
    return Astro.redirect(`/ammo/${id}/edit`);
  }

  await db.update(ammoInventory).set({
    caliber:      form.get('caliber') as string,
    brand:        form.get('brand') as string,
    grain:        form.get('grain') ? parseInt(form.get('grain') as string) : null,
    type:         form.get('type') as string,
    quantity:     parseInt(form.get('quantity') as string) || 0,
    costPerRound: form.get('costPerRound') ? parseFloat(form.get('costPerRound') as string) : null,
    notes:        form.get('notes') as string || null,
  }).where(eq(ammoInventory.id, id));
  return Astro.redirect('/ammo');
}

const purchases = await db.select().from(ammoPurchases).where(eq(ammoPurchases.ammoId, id)).orderBy(desc(ammoPurchases.date));
const totalSpent = purchases.reduce((s, p) => s + (p.totalCost ?? 0), 0);
const today = new Date().toISOString().split('T')[0];
---

<Layout title={`${ammo.brand} ${ammo.caliber}`} sub={`${ammo.quantity.toLocaleString()} rounds in stock`} backHref="/ammo">
  <div style="display:flex;flex-direction:column;gap:1.5rem;max-width:36rem">

    <!-- Edit fields -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">✎</span>
        <span class="section-title">Edit Details</span>
      </div>
      <form method="POST" class="card" style="padding:1.5rem">
        <div class="form-section">
          <div class="form-row form-row-2">
            <div><label>Caliber *</label><input name="caliber" type="text" required value={ammo.caliber} /></div>
            <div><label>Brand *</label><input name="brand" type="text" required value={ammo.brand} /></div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Grain</label><input name="grain" type="number" min="1" value={ammo.grain ?? ''} placeholder="115" /></div>
            <div>
              <label>Type *</label>
              <select name="type">
                {['FMJ','HP','SP','match','subsonic','other'].map(t => (
                  <option value={t} selected={ammo.type === t}>{t}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Quantity *</label><input name="quantity" type="number" min="0" required value={ammo.quantity} /></div>
            <div><label>Cost / Round ($)</label><input name="costPerRound" type="number" step="0.001" min="0" value={ammo.costPerRound ?? ''} placeholder="0.000" /></div>
          </div>
          <div><label>Notes</label><input name="notes" type="text" value={ammo.notes ?? ''} placeholder="Optional" /></div>
          <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
        </div>
      </form>
    </div>

    <!-- Purchase log -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">◉</span>
        <span class="section-title">Purchase Log</span>
        {totalSpent > 0 && <span style="margin-left:auto;font-size:0.75rem;color:#22c55e;font-weight:600">${totalSpent.toFixed(2)} total</span>}
      </div>

      {purchases.length > 0 && (
        <div class="card card-divide" style="margin-bottom:0.75rem">
          {purchases.map(p => (
            <div class="list-row" style="justify-content:space-between;align-items:flex-start">
              <div style="flex:1">
                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap">
                  <span style="font-size:0.8125rem;font-weight:600;color:var(--text)">+{p.quantity.toLocaleString()} rds</span>
                  {p.totalCost && <span style="font-size:0.8125rem;color:#22c55e">${p.totalCost.toFixed(2)}</span>}
                  {p.totalCost && p.quantity > 0 && <span style="font-size:0.7rem;color:var(--text-dim)">${(p.totalCost / p.quantity).toFixed(3)}/rd</span>}
                </div>
                <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.125rem">
                  {p.date}{p.source ? ` · ${p.source}` : ''}
                </div>
                {p.notes && <div style="font-size:0.75rem;color:var(--text-dim);margin-top:0.125rem">{p.notes}</div>}
              </div>
              <form method="POST">
                <input type="hidden" name="_action" value="delete_purchase" />
                <input type="hidden" name="purchaseId" value={p.id} />
                <button type="submit" class="btn-delete" title="Remove purchase (reverses quantity)">✕</button>
              </form>
            </div>
          ))}
        </div>
      )}

      <details class="accordion">
        <summary>+ Log Purchase</summary>
        <form method="POST" class="form-section">
          <input type="hidden" name="_action" value="log_purchase" />
          <div class="form-row form-row-2">
            <div><label>Date *</label><input name="date" type="date" required value={today} /></div>
            <div><label>Quantity *</label><input name="quantity" type="number" min="1" required placeholder="500" /></div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Total Cost ($)</label><input name="totalCost" type="number" step="0.01" min="0" placeholder="0.00" /></div>
            <div><label>Source / Retailer</label><input name="source" type="text" placeholder="e.g. Brownells" /></div>
          </div>
          <div><label>Notes</label><input name="notes" type="text" placeholder="Optional" /></div>
          <button type="submit" class="btn btn-primary">Log Purchase</button>
        </form>
      </details>
    </div>

    <!-- Delete -->
    <form method="POST" onsubmit="return confirm('Delete this ammo entry?')">
      <input type="hidden" name="_action" value="delete" />
      <button type="submit" class="btn btn-danger btn-full">Delete Entry</button>
    </form>

  </div>
</Layout>
