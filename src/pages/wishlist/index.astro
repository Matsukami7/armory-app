---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { wishList } from '../../db/schema';
import { eq, asc } from 'drizzle-orm';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action');

  if (action === 'add') {
    await db.insert(wishList).values({
      name:           form.get('name') as string,
      category:       form.get('category') as string || 'firearm',
      make:           form.get('make') as string || null,
      model:          form.get('model') as string || null,
      estimatedPrice: form.get('estimatedPrice') ? parseFloat(form.get('estimatedPrice') as string) : null,
      priority:       form.get('priority') as string || 'medium',
      url:            form.get('url') as string || null,
      notes:          form.get('notes') as string || null,
    });
  }

  if (action === 'acquire') {
    await db.update(wishList).set({
      acquired:     true,
      acquiredDate: new Date().toISOString().split('T')[0],
    }).where(eq(wishList.id, parseInt(form.get('id') as string)));
  }

  if (action === 'unacquire') {
    await db.update(wishList).set({ acquired: false, acquiredDate: null })
      .where(eq(wishList.id, parseInt(form.get('id') as string)));
  }

  if (action === 'delete') {
    await db.delete(wishList).where(eq(wishList.id, parseInt(form.get('id') as string)));
  }

  return Astro.redirect('/wishlist');
}

const all = await db.select().from(wishList).orderBy(asc(wishList.acquired), asc(wishList.createdAt));
const pending   = all.filter(i => !i.acquired);
const acquired  = all.filter(i => i.acquired);

const PRIORITY_ORDER = { high: 0, medium: 1, low: 2 };
pending.sort((a, b) => (PRIORITY_ORDER[a.priority as keyof typeof PRIORITY_ORDER] ?? 1) - (PRIORITY_ORDER[b.priority as keyof typeof PRIORITY_ORDER] ?? 1));

const PRIORITY_COLOR: Record<string, string> = {
  high:   '#f87171',
  medium: 'var(--accent)',
  low:    'var(--text-dim)',
};

const CATEGORY_ICON: Record<string, string> = {
  firearm:   '🔫',
  ammo:      '🎯',
  gear:      '🎒',
  accessory: '🔭',
  other:     '📦',
};

const totalEstimated = pending.reduce((s, i) => s + (i.estimatedPrice ?? 0), 0);
---

<Layout title="Wish List" sub={`${pending.length} item${pending.length !== 1 ? 's' : ''} · ${totalEstimated > 0 ? `~$${totalEstimated.toLocaleString('en-US', { maximumFractionDigits: 0 })} estimated` : 'no estimates'}`}>

  <div style="display:flex;flex-direction:column;gap:1.75rem;max-width:52rem">

    <!-- Pending items -->
    {pending.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:var(--accent);font-size:0.75rem">◈</span>
          <span class="section-title">Want to Acquire</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">{pending.length} item{pending.length !== 1 ? 's' : ''}</span>
        </div>
        <div class="card card-divide">
          {pending.map(item => (
            <div class="list-row" style="justify-content:space-between;align-items:flex-start;gap:1rem">
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                  <span style="font-size:0.75rem">{CATEGORY_ICON[item.category] ?? '📦'}</span>
                  <span style="font-size:0.875rem;font-weight:600;color:var(--text)">{item.name}</span>
                  <span style={`font-size:0.6rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:${PRIORITY_COLOR[item.priority]};border:1px solid currentColor;padding:0.1rem 0.4rem;border-radius:9999px;opacity:0.85`}>{item.priority}</span>
                </div>
                {(item.make || item.model) && (
                  <div style="font-size:0.75rem;color:var(--text-muted);margin-top:0.1rem">{item.make}{item.make && item.model ? ' ' : ''}{item.model}</div>
                )}
                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-top:0.25rem">
                  {item.estimatedPrice && <span style="font-size:0.8rem;font-weight:700;color:#22c55e">~${item.estimatedPrice.toLocaleString('en-US', { maximumFractionDigits: 0 })}</span>}
                  {item.url && <a href={item.url} target="_blank" rel="noopener" style="font-size:0.7rem;color:var(--accent)">Link →</a>}
                  {item.notes && <span style="font-size:0.72rem;color:var(--text-dim)">{item.notes}</span>}
                </div>
              </div>
              <div style="display:flex;gap:0.5rem;flex-shrink:0;align-items:center">
                <form method="POST">
                  <input type="hidden" name="_action" value="acquire" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="btn btn-secondary btn-sm" title="Mark as acquired">✓ Got it</button>
                </form>
                <form method="POST" onsubmit="return confirm('Remove from wish list?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="btn-delete">✕</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {pending.length === 0 && acquired.length === 0 && (
      <div class="empty-state">
        <div class="empty-state-icon">🛒</div>
        <div class="empty-state-text">Your wish list is empty. Add items below.</div>
      </div>
    )}

    <!-- Add form -->
    <div>
      <div class="section-header">
        <span style="color:var(--accent);font-size:0.75rem">+</span>
        <span class="section-title">Add Item</span>
      </div>
      <form method="POST" class="card" style="padding:1.5rem">
        <input type="hidden" name="_action" value="add" />
        <div class="form-section">
          <div class="form-row form-row-2">
            <div><label>Name *</label><input name="name" type="text" required placeholder="e.g. Ruger 10/22 Takedown" /></div>
            <div>
              <label>Category</label>
              <select name="category">
                <option value="firearm">Firearm</option>
                <option value="ammo">Ammo</option>
                <option value="accessory">Accessory</option>
                <option value="gear">Gear</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Make</label><input name="make" type="text" placeholder="Ruger" /></div>
            <div><label>Model</label><input name="model" type="text" placeholder="10/22" /></div>
          </div>
          <div class="form-row form-row-2">
            <div><label>Est. Price ($)</label><input name="estimatedPrice" type="number" min="0" step="0.01" placeholder="500" /></div>
            <div>
              <label>Priority</label>
              <select name="priority">
                <option value="high">High</option>
                <option value="medium" selected>Medium</option>
                <option value="low">Low</option>
              </select>
            </div>
          </div>
          <div><label>Link / URL</label><input name="url" type="url" placeholder="https://... (optional)" /></div>
          <div><label>Notes</label><input name="notes" type="text" placeholder="Optional" /></div>
          <button type="submit" class="btn btn-primary">Add to Wish List</button>
        </div>
      </form>
    </div>

    <!-- Acquired -->
    {acquired.length > 0 && (
      <div>
        <div class="section-header">
          <span style="color:#22c55e;font-size:0.75rem">✓</span>
          <span class="section-title">Acquired</span>
          <span style="margin-left:auto;font-size:0.7rem;color:var(--text-dim)">{acquired.length}</span>
        </div>
        <div class="card card-divide">
          {acquired.map(item => (
            <div class="list-row" style="justify-content:space-between;align-items:center;gap:1rem;opacity:0.6">
              <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap">
                  <span style="font-size:0.75rem">{CATEGORY_ICON[item.category] ?? '📦'}</span>
                  <span style="font-size:0.875rem;font-weight:600;color:var(--text);text-decoration:line-through">{item.name}</span>
                  {item.acquiredDate && <span style="font-size:0.7rem;color:var(--text-dim)">acquired {item.acquiredDate}</span>}
                </div>
              </div>
              <div style="display:flex;gap:0.5rem;flex-shrink:0">
                <form method="POST">
                  <input type="hidden" name="_action" value="unacquire" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="btn btn-secondary btn-sm" style="font-size:0.65rem">Undo</button>
                </form>
                <form method="POST" onsubmit="return confirm('Remove from wish list?')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="btn-delete">✕</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>
