---
import Layout from '../layouts/Layout.astro';
import { db } from '../db';
import { firearms, ammoInventory, rangeSessions, sessionFirearms } from '../db/schema';
import { sql, eq } from 'drizzle-orm';

let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const firearmId  = parseInt(form.get('firearmId') as string);
  const roundsFired = parseInt(form.get('roundsFired') as string) || 0;
  const ammoId     = form.get('ammoId') ? parseInt(form.get('ammoId') as string) : null;

  if (!isNaN(firearmId) && roundsFired > 0) {
    const today = new Date().toISOString().split('T')[0];

    // Find or create today's session
    const [existing] = await db.select().from(rangeSessions).where(eq(rangeSessions.date, today)).limit(1);
    let sessionId: number;
    if (existing) {
      sessionId = existing.id;
    } else {
      const result = await db.insert(rangeSessions).values({ date: today }).returning({ id: rangeSessions.id });
      sessionId = result[0].id;
    }

    await db.insert(sessionFirearms).values({ sessionId, firearmId, roundsFired, ammoId });

    if (ammoId && roundsFired > 0) {
      await db.run(sql`UPDATE ammo_inventory SET quantity = MAX(0, quantity - ${roundsFired}) WHERE id = ${ammoId}`);
    }

    const [gun] = await db.select({ name: firearms.name }).from(firearms).where(eq(firearms.id, firearmId));
    successMsg = `Logged ${roundsFired} rds with ${gun?.name ?? 'firearm'} to ${existing ? 'existing' : "today's new"} session.`;
  } else {
    errorMsg = 'Select a firearm and enter at least 1 round.';
  }
}

const allFirearms = await db.select().from(firearms).orderBy(firearms.name);
const allAmmo     = await db.select().from(ammoInventory).where(sql`quantity > 0`).orderBy(ammoInventory.caliber);
const today       = new Date().toISOString().split('T')[0];
const [todaySession] = await db.select().from(rangeSessions).where(eq(rangeSessions.date, today)).limit(1);
---

<Layout title="Quick Log" sub="Fast round-count entry">
  <slot name="actions" slot="actions">
    {todaySession && <a href={`/sessions/${todaySession.id}`} class="btn btn-secondary">View Today's Session →</a>}
  </slot>

  <div style="max-width:28rem;display:flex;flex-direction:column;gap:1.25rem">

    {successMsg && (
      <div style="padding:0.875rem 1rem;border-radius:0.5rem;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);color:#4ade80;font-size:0.875rem">
        ✓ {successMsg}
      </div>
    )}
    {errorMsg && (
      <div style="padding:0.875rem 1rem;border-radius:0.5rem;background:rgba(248,113,113,0.1);border:1px solid rgba(248,113,113,0.3);color:#f87171;font-size:0.875rem">
        {errorMsg}
      </div>
    )}

    <div class="card" style="padding:1.5rem">
      <form method="POST" class="form-section" id="quick-log-form">
        <div>
          <label>Firearm *</label>
          <select name="firearmId" required id="ql-firearm" onchange="qlFilterAmmo()">
            <option value="">Select firearm…</option>
            {allFirearms.map(f => <option value={f.id} data-caliber={f.caliber}>{f.name} ({f.caliber})</option>)}
          </select>
        </div>

        <div>
          <label>Rounds Fired *</label>
          <input name="roundsFired" type="number" min="1" placeholder="50" required id="ql-rounds"
            style="font-size:1.5rem;font-weight:700;text-align:center;padding:0.75rem;color:var(--accent)" />
        </div>

        <div>
          <label>Ammo Used <span style="color:var(--text-dim);font-weight:400">(optional)</span></label>
          <select name="ammoId" id="ql-ammo">
            <option value="">None</option>
            {allAmmo.map(a => (
              <option value={a.id} data-caliber={a.caliber}>
                {a.brand} {a.grain ? `${a.grain}gr ` : ''}{a.caliber} — {a.quantity.toLocaleString()} in stock
              </option>
            ))}
          </select>
        </div>

        <button type="submit" class="btn btn-primary btn-full" style="font-size:1rem;padding:0.875rem">
          Log Rounds →
        </button>
      </form>
    </div>

    <div style="font-size:0.75rem;color:var(--text-dim);text-align:center;line-height:1.6">
      Rounds are added to today's session ({today}).<br />
      A new session is created automatically if one doesn't exist.
    </div>

  </div>
</Layout>

<script>
  function qlFilterAmmo() {
    const firearmSel = document.getElementById('ql-firearm') as HTMLSelectElement | null;
    const ammoSel    = document.getElementById('ql-ammo') as HTMLSelectElement | null;
    if (!firearmSel || !ammoSel) return;
    const caliber = firearmSel.options[firearmSel.selectedIndex]?.dataset?.caliber ?? '';
    Array.from(ammoSel.options).forEach(opt => {
      if (!opt.value) return;
      opt.hidden = caliber ? opt.dataset.caliber !== caliber : false;
    });
    if (ammoSel.options[ammoSel.selectedIndex]?.hidden) ammoSel.value = '';
  }

  // Auto-focus rounds after firearm is selected
  document.getElementById('ql-firearm')?.addEventListener('change', () => {
    setTimeout(() => (document.getElementById('ql-rounds') as HTMLInputElement | null)?.focus(), 50);
  });
</script>
