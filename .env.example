# Password to protect the app. Default is "changeme" — change before deploying.
ARMORY_PASSWORD=changeme

# SQLite database path (set automatically in Docker — don't change this)
DB_PATH=/data/armory.db

# Public-facing URL — REQUIRED when running behind a reverse proxy (Caddy, nginx, Traefik, openresty, etc.)
# Without this, Astro's CSRF protection will block all form submissions from your domain.
# Example: ORIGIN=https://armory.yourdomain.com
# Leave blank or omit when accessing by IP directly.
ORIGIN=
